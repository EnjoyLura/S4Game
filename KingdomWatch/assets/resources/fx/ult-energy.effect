CCEffect %{
  techniques:
  - passes:
    - vert: ultimate-vs:vert
      frag: ultimate-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        energyState: { value: [0, 0, 0, 2] }
        energyColor: { value: [0.12, 0.62, 1.0, 1.0] }
}%

CCProgram ultimate-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * p;
  }
}%

CCProgram ultimate-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  uniform Energy {
    vec4 energyState;
    vec4 energyColor;
  };
  float band(float distance, float width) {
    return exp(-distance * distance / (width * width));
  }
  vec4 frag () {
    vec2 p = (uv0 - 0.5) * 168.0;
    float r = length(p);
    float angle = fract(atan(p.y, p.x) / 6.2831853 + 0.75);
    float time = energyState.x;
    float pct = energyState.y;
    float mode = energyState.z;
    float age = energyState.w;
    float ready = step(0.5, mode);
    float releasing = 1.0 - step(-0.5, mode);
    float charging = (1.0 - ready) * (1.0 - releasing);
    float pulse = 0.88 + 0.12 * sin(time * 2.6);
    float intensity = 0.0;
    float white = 0.0;
    vec3 tint = energyColor.rgb;

    // Charge lives inside the icon. Only a faint edge tint appears near full.
    intensity += charging * pct * band(r - 46.0, 1.3) * 0.1;

    // Continuous edge light joins the illustration to its soft outer aura.
    // Keep the original burst aura separate so completion retains its impact.
    float inner = band(r - 47.0, 1.1);
    float outer = band(r - 51.0, 3.4);
    float aura = band(r - 57.0, 7.0);
    float edgeAura = band(r - 46.5, 7.5);
    intensity += ready * pulse * (inner * 0.55 + outer * 0.25 + edgeAura * 0.3);
    white += ready * band(r - 47.0, 0.55) * 0.32;
    float phase = fract(angle + time * 0.21);
    float trail = pow(1.0 - phase, 12.0) + pow(1.0 - fract(phase + 0.5), 16.0) * 0.7;
    intensity += ready * trail * band(r - 48.5, 3.5) * 0.35;
    white += ready * trail * inner * 0.42;

    // Irregular electric strands outside the ring, moving independently of it.
    float zigzag = sin(angle * 6.2831853 * 29.0 + time * 15.0) * 1.6;
    zigzag += sin(angle * 6.2831853 * 57.0 - time * 9.0) * 0.75;
    float strand = band(r - (53.0 + zigzag), 0.55);
    float arcGate = pow(max(0.0, cos(angle * 6.2831853 * 3.0 - time * 1.8)), 12.0);
    intensity += ready * strand * arcGate * 0.36;
    white += ready * strand * arcGate * 0.3;

    // Completion lasts 0.75s: close inward, flash, then send two waves out.
    float burst = ready * (1.0 - smoothstep(0.08, 0.75, age));
    float closure = band(r - (72.0 - 18.5 * min(age / 0.13, 1.0)), 1.5);
    float wave = band(r - (53.5 + 25.0 * min(age / 0.65, 1.0)), 1.7);
    float wave2 = band(r - (53.5 + 20.0 * clamp((age - 0.09) / 0.6, 0.0, 1.0)), 1.0);
    float rayAngle = cos(angle * 6.2831853 * 16.0);
    float rays = pow(max(0.0, rayAngle), 24.0) * smoothstep(45.0, 51.0, r);
    rays *= 1.0 - smoothstep(60.0, 79.0, r);
    intensity += burst * (closure * 0.7 + wave * 0.95 + wave2 * 0.65 + rays * 0.85 + aura * 0.6);
    white += burst * (closure + wave + rays) * 0.45;
    float inside = 1.0 - smoothstep(43.0, 46.0, r);
    white += ready * inside * (1.0 - smoothstep(0.025, 0.12, age)) * 0.65;

    // Periodic diagonal icon sheen; the picture remains clear between passes.
    float scan = band(p.x + p.y * 0.45 - (-80.0 + fract(time / 2.8) * 340.0), 3.5);
    white += ready * inside * scan * 0.3;

    // Release discharges the edge into moving sparks, then fades into charge.
    float releaseProgress = clamp(age / 0.55, 0.0, 1.0);
    float releaseFade = 1.0 - smoothstep(0.12, 0.55, age);
    float releaseWave = band(r - (47.0 + 24.0 * releaseProgress), 1.1);
    float edgeBreak = pow(max(0.0, cos(angle * 6.2831853 * 9.0 + age * 10.0)), 20.0);
    intensity += releasing * releaseFade * (releaseWave * 0.32 + edgeBreak * band(r - 47.0, 3.5) * 0.5);
    float sparks = 0.0;
    for (int i = 0; i < 10; i++) {
      float index = float(i);
      float theta = index * 2.39996 + 0.35;
      float speed = 18.0 + mod(index, 3.0) * 5.0;
      vec2 at = vec2(cos(theta), sin(theta)) * (47.0 + releaseProgress * speed);
      at.y += releaseProgress * releaseProgress * 6.0;
      sparks += band(length(p - at), 0.8 + mod(index, 2.0) * 0.35);
    }
    intensity += releasing * releaseFade * sparks * 0.8;
    white += releasing * releaseFade * sparks * 0.65;
    white += releasing * inside * (1.0 - smoothstep(0.02, 0.10, age)) * 0.45;

    vec3 rgb = mix(tint, vec3(0.87, 0.98, 1.0), clamp(white, 0.0, 1.0));
    float alpha = clamp(intensity + white, 0.0, 1.0) * color.a;
    alpha *= 1.0 - smoothstep(80.0, 84.0, r);
    return vec4(rgb * color.rgb, alpha);
  }
}%
