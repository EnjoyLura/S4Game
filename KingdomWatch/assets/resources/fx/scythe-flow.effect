CCEffect %{
  techniques:
  - passes:
    - vert: scythe-vs:vert
      frag: scythe-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 0] }
        fxShape: { value: [250, 250, 100, 0] }
}%
CCProgram scythe-vs %{
 precision highp float;
 #include <builtin/uniforms/cc-global>
 #if USE_LOCAL
  #include <builtin/uniforms/cc-local>
 #endif
 in vec3 a_position;in vec2 a_texCoord;in vec4 a_color;
 out vec2 uv0;out vec4 color;
 vec4 vert(){vec4 p=vec4(a_position,1.);
  #if USE_LOCAL
   p=cc_matWorld*p;
  #endif
  uv0=a_texCoord;color=a_color;return cc_matViewProj*p;
 }
}%
CCProgram scythe-fs %{
 precision highp float;
 in vec2 uv0;in vec4 color;
 uniform ScytheFlow {vec4 fxState;vec4 fxShape;};
 const vec3 RED=vec3(.78,.006,.025),ORANGE=vec3(1.,.045,.055),GOLD=vec3(1.,.22,.08),WHITE=vec3(1.,.83,.63);
 float sat(float x){return clamp(x,0.,1.);}
 float bell(float d,float w){return exp(-d*d/max(.000001,w*w));}
 float hash(float x){return fract(sin(x*127.1)*43758.5453);}
 float noise(float x){float i=floor(x),f=fract(x);return mix(hash(i),hash(i+1.),f*f*(3.-2.*f));}
 vec2 rot(vec2 p,float a){float c=cos(a),s=sin(a);return vec2(c*p.x-s*p.y,s*p.x+c*p.y);}
 float segment(vec2 p,vec2 a,vec2 b){vec2 d=b-a;return length(p-a-d*clamp(dot(p-a,d)/dot(d,d),0.,1.));}
 vec4 frag(){
  vec2 q=(vec2(uv0.x,1.-uv0.y)-.5)*fxShape.xy/max(1.,fxShape.z);
  float age=fxState.x,seed=fxState.y*37.,mode=fxState.w,t=fxShape.w;
  vec3 rgb=vec3(0.);float alpha=0.;
  if(mode<.5){
   float x=q.x,env=sqrt(max(0.,1.-x*x)),edge=.72*(env-1.),tail=edge-q.y;
   float teeth=.72+.19*sin((x+1.)*15.5-age*8.)+.13*sin((x+1.)*29.5-age*16.+1.4);
   float u=tail/max(.02,env*teeth),side=1.-smoothstep(.97,1.01,abs(x));
   float body=smoothstep(-.01,.015,tail)*(1.-smoothstep(.70,1.,u))*side;
   float warp=u+noise(x*13.-age*5.+seed)*.12;
   vec3 flame=mix(GOLD,ORANGE,smoothstep(.04,.18,warp));flame=mix(flame,RED*.55,smoothstep(.18,.30,warp));
   flame=mix(flame,vec3(.002,0.,.001),smoothstep(.30,.45,warp));
   alpha=body*.94;rgb=flame*body+WHITE*bell(tail,.008)*side+ORANGE*bell(tail,.027)*side*.5;
  }else if(mode<1.5){
   // Twin handleless sickles with continuous coiled wake, inspired by ninja spiral structure.
   vec2 p=q/vec2(1.,.88);float r=length(p),a=atan(p.y,p.x),spin=age*42.4+seed;
   alpha=(1.-smoothstep(.55,.91,r))*.66;rgb=vec3(.01,0.,.002)*alpha;
   for(int k=0;k<2;k++){
    float angle=a-spin-float(k)*3.14159,arc=atan(sin(angle),cos(angle));
    float gate=smoothstep(-2.7,-2.3,arc)*(1.-smoothstep(-.04,.1,arc)),u=sat(-arc/2.7);
    float rr=.90-u*.16,width=.03+.08*u;
    rgb+=RED*bell(r-rr,width)*gate*(1.-u*.7)+WHITE*bell(r-rr,.009)*gate*(1.-u)*.65;
   }
   for(int k=0;k<8;k++){
    float i=float(k),arc=a-spin*.7-i*.7854,coil=.14+.11*mod(arc+12.56,6.2832);
    rgb+=RED*bell(r-coil,.032)*.26+ORANGE*bell(r-(.94+.015*i),.006)*pow(sat(sin(arc)),4.)*.25;
   }
   rgb+=RED*bell(r,.18)*.35+ORANGE*bell(r,.055)*(.7+.2*sin(age*25.));
  }else if(mode<2.5){
   float r=length(q),a=atan(q.y,q.x),fade=pow(1.-sat(t),2.);
   rgb=WHITE*bell(r,.12)*(1.-t)*1.2+ORANGE*bell(r-.05-t*.55,.025)*fade*.55;
   for(int k=0;k<7;k++){
    float i=float(k),a0=i*2.39996+seed;vec2 dir=vec2(cos(a0),sin(a0));
    float along=dot(q,dir),crossed=dot(q,vec2(-dir.y,dir.x));
    rgb+=GOLD*bell(crossed,.012)*bell(along-(.12+t*.8),.08)*fade;
   }
  }else if(mode<3.5){
   float r=length(q),a=atan(q.y,q.x),radius=.8*(1.-t)+.1;
   rgb=RED*bell(r,radius*.5)*.25+GOLD*bell(r,.07)*(.3+t);
   rgb+=ORANGE*bell(r-radius,.015)*pow(sat(cos(a*3.+age*12.)),4.)*.8;
  }else if(mode<4.5){
   vec2 p=rot(q,-t*5.+.7);float r=length(p),a=atan(p.y,p.x),gate=pow(sat(cos(a)),2.);
   float radius=.65+.25*t,fade=1.-sat(t);
   rgb=WHITE*bell(r-radius,.012)*gate*fade+ORANGE*bell(r-radius+.04,.06)*gate*fade*.8;
   rgb+=RED*bell(r-radius+.12,.15)*gate*fade*.35;
  }else if(mode<5.5){
   // Dense dark-red footprint below actors, irregular rim mist and lifted embers.
   float r=length(q),a=atan(q.y,q.x),rise=smoothstep(0.,.38,age),fade=1.-smoothstep(.84,1.,t);
   float n=noise(a*4.+r*12.-age*1.7+seed),radius=mix(.76,1.,rise);
   float inside=1.-smoothstep(radius-.12,radius+.035+.025*n,r);
   alpha=inside*(.61+.10*n)*rise*fade;
   rgb=vec3(.041,.001,.007)*alpha+RED*pow(sat(sin(r*25.+n*6.-age*4.)),8.)*inside*.025*rise*fade;
   float gaps=pow(sat(sin(a*5.+seed)+.35*sin(a*13.-age*2.)),3.);
   rgb+=RED*bell(r-radius,.028)*gaps*.3*rise*fade;
   for(int k=0;k<20;k++){
    float i=float(k),theta=i*2.39996+seed,rr=radius*(.88+.10*hash(i+seed));
    vec2 base=vec2(cos(theta),sin(theta))*rr;
    float h=fract(age*.9+hash(i+5.)),height=.08+.25*h,flick=sin(h*3.14159)*(1.-h)*rise*fade;
    vec2 v=q-base;float bend=sin(v.y*19.+i-age*3.)*.02;
    float smoke=bell(v.y-height*.5,height*.55)*bell(v.x-bend,.025+.015*h);
    rgb+=RED*smoke*flick*.16;alpha+=smoke*flick*.05;
    rgb+=ORANGE*bell(v.y-height*.8,.007)*bell(v.x-bend,.003)*flick*.45;
   }
  }else if(mode<6.5){
   float r=length(q),a=atan(q.y,q.x),fade=pow(1.-sat(t),2.);
   float radius=mix(1.05,.05,sat(t*1.8));
   float gaps=pow(sat(sin(a*7.+seed)+.3*sin(a*17.-age*5.)),3.);
   rgb=RED*bell(r-radius,.045)*gaps*fade*.6+WHITE*bell(r,.045+t*.1)*exp(-t*18.)*1.8;
   rgb+=ORANGE*bell(r,.14)*exp(-t*10.)*.9;
  }else if(mode<7.5){
   // Each slash owns a short-lived moving wake: ash, crimson vapor and sparse hot sparks.
   float fade=pow(1.-sat(t),1.5),n=noise(q.x*13.-age*12.+seed);
   float smoke=bell(q.y-sin(q.x*7.+seed-age*8.)*.028-age*.10,.04+age*.1)*(1.-smoothstep(.65,1.2,abs(q.x)));
   alpha=smoke*fade*.13;rgb=RED*smoke*(.08+.09*n)*fade;
   for(int k=0;k<18;k++){
    float i=float(k),s=hash(i*17.+seed),side=mod(i,2.)*2.-1.;
    vec2 origin=vec2((s*2.-1.)*.94,.0),velocity=vec2((hash(i+7.+seed)-.5)*.7,side*(.15+.5*hash(i+3.+seed)));
    vec2 d=q-origin-velocity*age;
    float ember=bell(d.x,.007+.016*s)*bell(d.y,.003+.004*s)*fade;
    rgb+=mix(ORANGE,GOLD,s)*ember*(.65+s);
    float shred=bell(d.x+age*.06,.018)*bell(d.y,.005)*fade;
    alpha+=shred*.40;rgb+=RED*shred*.12;
   }
  }
  else{
   // Detached tangential wakes dissolve the silhouette; no complete luminous ring.
   vec2 p=q/vec2(1.,.68);float r=length(p),a=atan(p.y,p.x);
   float layer=t<.5?smoothstep(-.04,.04,q.y):1.-smoothstep(-.04,.04,q.y);
   for(int k=0;k<18;k++){
    float i=float(k),h=hash(i+seed),u=fract(age*(.75+h*.55)+h);
    float theta=i*2.39996+age*(2.4+h*1.7),rr=.72+u*(.65+h*.22);
    float da=atan(sin(a-theta),cos(a-theta));
    float tail=sat(-da/(.25+h*.55)),gate=smoothstep(-.7-h*.3,-.45-h*.2,da)*(1.-smoothstep(-.04,.06,da));
    float curve=rr-tail*.15,fade=sin(u*3.14159)*(1.-u)*gate;
    float mist=bell(r-curve,.035+.08*tail)*fade;
    alpha+=mist*.16;rgb+=RED*mist*.13;
    rgb+=ORANGE*bell(r-curve,.005+h*.005)*fade*(.32+h*.40);
    vec2 center=vec2(cos(theta),sin(theta))*rr,d=p-center;
    float spark=bell(dot(d,vec2(-sin(theta),cos(theta))),.014+.035*h)*bell(dot(d,vec2(cos(theta),sin(theta))),.004);
    rgb+=GOLD*spark*sin(u*3.14159)*(.12+.25*h);
   }
   rgb*=layer;alpha*=layer;
  }
  float bounds=(1.-smoothstep(.94,1.,abs(uv0.x-.5)*2.))*(1.-smoothstep(.94,1.,abs(uv0.y-.5)*2.));
  float power=max(0.,fxState.z)*bounds;
  return vec4(max(rgb,vec3(0.))*power*color.rgb,sat(alpha*power)*color.a);
 }
}%
