CCEffect %{
  techniques:
  - passes:
    - vert: wind-ninja-vs:vert
      frag: wind-ninja-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 0] }
        fxShape: { value: [250, 250, 100, 4] }
}%

CCProgram wind-ninja-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * p;
  }
}%

CCProgram wind-ninja-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  // x: effect age in battle seconds, y: stable seed, z: parent opacity,
  // w: 0 eye / 1 tornado / 2 arrival field / 3 local +X crescent / 4 +Y flight.
  uniform HeroFlow {
    vec4 fxState;
    vec4 fxShape;
  };
  const float TAU = 6.28318530718;
  float sat(float x) { return clamp(x, 0.0, 1.0); }
  // Compact polynomial bell: degree six in distance, zero outside width.
  // No exp/pow, texture reads, derivatives, or unbounded glow tails.
  float bell(float d, float width) {
    float v = sat(1.0 - d * d / max(width * width, 0.000001));
    return v * v * (3.0 - 2.0 * v);
  }
  float hash21(vec2 p) {
    vec3 q = fract(vec3(p.x, p.y, p.x) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
  }
  float windNoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),
      mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0)), f.x), f.y);
  }
  float mist(vec2 p) {
    // Exactly two octaves; rotation breaks the lattice's preferred axes.
    return windNoise(p) * 0.666667 + windNoise(mat2(1.6, 1.2, -1.2, 1.6) * p
      + vec2(7.1, 3.7)) * 0.333333;
  }
  vec2 turn(vec2 p, float a) {
    float c = cos(a), s = sin(a);
    return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
  }
  float angleOf(vec2 p) {
    // atan(0,0) is undefined on some mobile GPUs.
    return dot(p, p) > 0.00000001 ? atan(p.y, p.x) : 0.0;
  }

  // v123: analytic wind surfaces. Only one two-octave advected field per
  // mode, outside every fixed loop. No texture, raymarch, or wall clock.
  vec4 windEye(vec2 p, float age, float seed, float aa) {
    vec2 q = turn(p, -0.14) / vec2(1.04, 0.64);
    float r = length(q), a = angleOf(q);
    float n = mist(turn(q, -age * 0.85) * 3.6 + vec2(seed, -age * 0.65));
    float coverage = 0.0;
    vec3 light = vec3(0.0);
    // Six finite brush sheets: unequal sweep, radius, thickness and speed.
    // A filled, lit shoulder carries each wisp; its cut edge is secondary.
    for (int i = 0; i < 6; i++) {
      float k = float(i), s = hash21(vec2(k + 31.0, seed));
      float heading = k * 1.04719755 + s * 0.46 + age * (1.1 + s * 0.25) + seed;
      float delta = a - heading;
      float arc = atan(sin(delta), cos(delta));
      float u = arc / (0.90 + s * 0.35);
      float end = smoothstep(-1.0, -0.52, u) * (1.0 - smoothstep(0.55, 1.0, u));
      float sweep = 0.58 + s * 0.21 + u * (0.16 + s * 0.07)
        + sin(u * 3.5 + k) * 0.055;
      float width = (0.12 + s * 0.075) * (0.65 + 0.35 * sat(u + 0.5));
      float d = r - sweep + (n - 0.5) * 0.11;
      float sheet = bell(d, width + aa) * end;
      float shoulder = bell(d + width * 0.18, width * 0.63 + aa) * end;
      float brush = 0.65 + 0.35 * sin(r * 42.0 + u * 7.0 - age * 4.0 + n * 4.0);
      float rim = bell(d - width * 0.53, width * 0.22 + aa) * end
        * smoothstep(0.23, 0.68, n + 0.17 * sin(u * 14.0 + k));
      float nearFace = 0.48 + 0.52 * sat(0.5 - q.y * 0.6);
      float alpha = sheet * (0.14 + n * 0.08);
      coverage += alpha * (1.0 - coverage);
      light += vec3(0.005, 0.27, 0.38) * alpha;
      light += vec3(0.012, 0.57, 0.69) * sheet * nearFace * (0.42 + n * 0.38);
      light += vec3(0.10, 0.77, 0.85) * shoulder * brush * nearFace * 0.38;
      light += vec3(0.57, 0.98, 1.0) * rim * nearFace * 0.48;
    }
    // A small round white-cyan orb sits inside the oblique hollow wind eye.
    float coreR = length(p);
    light += vec3(0.02, 0.40, 0.55) * bell(coreR, 0.27) * 0.43;
    light += vec3(0.19, 0.88, 1.0) * bell(coreR, 0.12) * 0.92;
    light += vec3(0.84, 1.0, 1.0) * bell(coreR, 0.058) * 1.15;
    float bound = 1.0 - smoothstep(1.04, 1.18, r);
    return vec4(light * bound, min(0.55, coverage) * bound);
  }

  // Volume, not two painted cone faces: integrate a rotating 3D density field.
  // Twelve fixed samples, bounded to the ray/frustum intersection. The wind's
  // coordinates rotate AND rise; the density never jumps at a frame boundary.
  float flowHash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
  }
  float flowNoise(vec3 p) {
    vec3 cell = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    vec4 a = vec4(flowHash(cell), flowHash(cell + vec3(1.0, 0.0, 0.0)),
      flowHash(cell + vec3(0.0, 1.0, 0.0)), flowHash(cell + vec3(1.0, 1.0, 0.0)));
    vec4 b = vec4(flowHash(cell + vec3(0.0, 0.0, 1.0)), flowHash(cell + vec3(1.0, 0.0, 1.0)),
      flowHash(cell + vec3(0.0, 1.0, 1.0)), flowHash(cell + vec3(1.0, 1.0, 1.0)));
    vec4 c = mix(a, b, f.z);
    return mix(mix(c.x, c.y, f.x), mix(c.z, c.w, f.x), f.y);
  }

  vec4 tornadoDust(vec2 q, float age, float seed) {
    // Low, grey-brown ground dust. Each cloud rolls out, grows and dissipates;
    // no continuous painted ring and no luminous green dust plate.
    vec2 ground = vec2(q.x / 0.76, (q.y + 1.03) / 0.23);
    float n = mist(turn(ground, age * 0.7) * 3.2 + vec2(seed, age * 0.4));
    float haze = bell(length(ground) - 0.32, 0.65) * (0.4 + n * 0.6) * 0.09;
    vec3 light = vec3(0.47, 0.44, 0.38) * haze;
    float alpha = haze;
    for (int i = 0; i < 10; i++) {
      float fi = float(i), s = hash21(vec2(fi + 71.0, seed));
      float t = fract(age * (0.32 + s * 0.08) + s);
      float theta = seed + fi * 2.39996 - age * 1.8;
      float spread = 0.12 + t * 0.62;
      vec2 center = vec2(cos(theta) * spread,
        -1.03 - sin(theta) * spread * 0.22 + t * 0.10);
      float lifted = step(6.5, fi);
      // Three smaller powder clouds are picked up into the lower funnel.
      vec2 rising = vec2(cos(theta) * (0.12 + t * 0.22),
        -1.01 + t * 0.72 - sin(theta) * (0.12 + t * 0.22) * 0.34);
      center = mix(center, rising, lifted);
      vec2 size = mix(vec2(0.14 + t * 0.21, 0.09 + t * 0.11),
        vec2(0.07 + t * 0.09, 0.05 + t * 0.10), lifted);
      vec2 d = (q - center) / size;
      float shape = bell(length(d) + (n - 0.5) * 0.42, 1.0);
      float life = smoothstep(0.0, 0.14, t) * (1.0 - smoothstep(0.52, 1.0, t));
      float a = shape * life * (0.27 + n * 0.18) * mix(1.0, 0.58, lifted);
      vec3 shade = mix(vec3(0.38, 0.36, 0.32), vec3(0.68, 0.64, 0.56), n);
      light += (1.0 - alpha) * shade * a;
      alpha += (1.0 - alpha) * a;
    }
    return vec4(light, alpha);
  }

  vec4 tornado(vec2 q, float age, float seed, float aa) {
    vec4 dust = tornadoDust(q, age, seed);
    vec3 light = dust.rgb;
    float coverage = dust.a;

    // Orthographic camera looks down at the ground. At each ray sample the
    // height changes with depth, so front flow crosses below rear flow.
    const float tilt = 0.34;
    const float slope = 0.43;
    float center = 0.050 * sin((q.y + 1.0) * 2.1 - age * 0.85 + seed);
    float x = q.x - center;
    float rad0 = 0.16 + slope * (q.y + 1.0);
    const float k = slope * tilt;
    const float A = 1.0 - k * k;
    float disc = rad0 * rad0 - A * x * x;
    if (disc > 0.0 && q.y > -1.20 && q.y < 1.62) {
      float root = sqrt(disc);
      float nearZ = (rad0 * k + root) / A;
      float farZ = (rad0 * k - root) / A;
      float stepLength = (nearZ - farZ) / 12.0;
      for (int i = 0; i < 12; i++) {
        float z = nearZ - (float(i) + 0.5) * stepLength;
        float y = q.y + tilt * z;
        float h = (y + 1.03) / 2.35;
        float v = sat(h);
        float vertical = smoothstep(0.0, 0.075, h) * (1.0 - smoothstep(0.88, 1.05, h));
        float bend = 0.050 * sin(v * 5.0 - age * 0.85 + seed);
        vec2 radial = vec2(q.x - bend, z);
        float radius = 0.105 + 0.77 * mix(v, sqrt(max(v, 0.0)), 0.35);
        float rr = length(radial) / max(radius, 0.01);
        // Exact three-dimensional advection, a turntable plus upward transport.
        // Material flow: dh/dt = 1/6, dtheta/dt = -1.5. Normalized
        // cross-section coordinates expand naturally as the cone gets wider.
        vec2 advected = turn(radial / max(radius, 0.01), age * 1.5);
        vec3 fluid = vec3(advected.x * 2.9, v * 7.5 - age * 1.25, advected.y * 2.9) + seed;
        float coarse = flowNoise(fluid);
        // Stretched material coordinates: many thin wind fibres, with slow
        // change along their length and fast change across their width.
        float fine = flowNoise(vec3(advected.x * 2.1 + 7.1,
          v * 38.0 - age * 6.333333 + 11.3, advected.y * 2.1 + 3.9));
        float n = coarse * 0.68 + fine * 0.32;
        float theta = angleOf(radial);
        // Broad interpenetrating whorls have a low-density interior between
        // them, rather than empty cone sections separated by a perfect helix.
        float swirl = theta - v * 24.0 + age * 5.5
          + (coarse - 0.5) * 3.8 + (fine - 0.5) * 0.6;
        float fold = sin(swirl) * 0.5 + 0.5;
        float billow = smoothstep(0.20, 0.77, n + fold * 0.27);
        float edgeWarp = (coarse - 0.5) * 0.22 + (fine - 0.5) * 0.09;
        float shell = smoothstep(0.12, 0.64, rr) * (1.0 - smoothstep(0.74, 1.12, rr + edgeWarp));
        float density = shell * vertical * (0.18 + billow * (0.48 + fold * 1.25));
        float optical = density * stepLength * 3.0;
        float a = optical / (1.0 + optical);
        // Self shading: back volume darker, front-facing folds and broken
        // filament ridges mint-white. The light comes from shaped wind mass.
        float front = sat(0.5 + z / max(radius, 0.01) * 0.5);
        float litFold = smoothstep(0.55, 0.96, fold) * smoothstep(0.38, 0.76, fine);
        float fiber = 0.75 + 0.25 * sin(v * 125.0 - age * 10.333333 + theta * 7.0 + coarse * 8.0);
        vec3 shade = mix(vec3(0.025, 0.26, 0.20), vec3(0.19, 0.65, 0.44), front * 0.62 + billow * 0.30);
        shade += vec3(0.78, 1.10, 0.84) * litFold * fiber * (0.45 + front * 0.55);
        shade += vec3(0.05, 0.25, 0.13) * fold * 0.4;
        light += (1.0 - coverage) * shade * a;
        // Scattered emission makes wisps visible over dark trees without
        // turning the whole funnel into a solid overexposed green cutout.
        light += (1.0 - coverage) * vec3(0.22, 0.63, 0.34) * litFold * shell * vertical * stepLength * 0.65;
        coverage += (1.0 - coverage) * a;
      }
    }
    // A torn, sub-pixel-accurate skin keeps the wind edges readable at phone
    // scale. It follows the same 3D rotation as the volume, never a screen ring.
    // The underlying integrated mass supplies thickness between these wisps.
    float skinR = 0.12 + 0.34 * (q.y + 1.03);
    const float skinK = 0.34 * tilt;
    const float skinA = 1.0 - skinK * skinK;
    float skinD = skinR * skinR - skinA * x * x;
    if (skinD > 0.0) {
      float sz = (skinR * skinK + sqrt(skinD)) / skinA;
      float sh = (q.y + tilt * sz + 1.03) / 2.35;
      float theta = angleOf(vec2(x, sz));
      vec2 adv = turn(vec2(x, sz) / max(0.12 + 0.799 * sh, 0.01), age * 1.5);
      float n = flowNoise(vec3(adv.x * 2.1 + 7.1, sh * 38.0 - age * 6.333333 + 11.3, adv.y * 2.1 + 3.9));
      float coarse = flowNoise(vec3(adv.x * 2.9, sh * 7.5 - age * 1.25, adv.y * 2.9) + seed);
      float phase = theta - sh * 24.0 + age * 5.5
        + (coarse - 0.5) * 3.8 + (n - 0.5) * 0.6;
      float windEdge = bell(1.0 - cos(phase - 0.60 + (n - 0.5) * 0.35), 0.16);
      float fineEdge = bell(1.0 - cos(phase - 0.89 + (n - 0.5) * 0.20), 0.045);
      float broken = smoothstep(0.36, 0.73, n)
        * (0.28 + 0.72 * smoothstep(0.30, 0.72, coarse));
      float heightMask = smoothstep(0.02, 0.08, sh) * (1.0 - smoothstep(0.90, 1.04, sh));
      float edgeFacing = smoothstep(0.0, 0.22, sqrt(skinD));
      float skin = windEdge * broken * heightMask * edgeFacing;
      light += vec3(0.34, 0.70, 0.47) * skin * 0.30;
      light += vec3(0.65, 0.90, 0.70) * fineEdge * broken * heightMask * edgeFacing * 0.16;
    }
    // The crown releases finite wisps into the air. Their unequal lengths and
    // torn tapered tips break the closed, perfectly regular funnel outline.
    vec2 crown = vec2(q.x / 0.98, (q.y - 1.17) / 0.27);
    float cr = length(crown), ca = angleOf(crown);
    float crownN = windNoise(turn(crown, age * 1.5) * 4.3 + seed);
    for (int i = 0; i < 3; i++) {
      float fi = float(i);
      float delta = ca + age * 1.5 - seed - fi * 2.37;
      float arc = atan(sin(delta), cos(delta));
      float u = arc / (1.05 + fi * 0.11);
      float ends = smoothstep(-1.0, -0.66, u) * (1.0 - smoothstep(0.45, 1.0, u));
      float r = 0.66 + fi * 0.095 + u * 0.10 + (crownN - 0.5) * 0.10;
      float w = (0.07 + fi * 0.015) * (0.75 + 0.25 * sin(u * 3.0));
      float sheet = bell(cr - r, w + aa) * ends * (0.3 + 0.7 * crownN);
      float facing = 0.35 + 0.65 * sat(0.5 - crown.y * 0.6);
      light += vec3(0.16, 0.54, 0.35) * sheet * facing * 0.32;
    }
    return vec4(light, min(0.72, coverage));
  }

  float shurikenShape(vec2 q) {
    vec2 b = abs(q);
    return (max(b.x, b.y) + 3.0 * min(b.x, b.y) - 0.95) / 3.16227766;
  }

  vec3 ninjaFlow(vec2 p, float age, float seed, float aa, float flight) {
    float arrival=mix(.72+.28*smoothstep(0.0,.20,age),.67,flight);
    vec2 q=p/arrival,disc=turn(q,-.12)/vec2(1.0,mix(.70,.78,flight));
    float r=length(disc),a=angleOf(disc),spin=age*17.0+seed;
    vec2 blade=turn(disc,-spin);
    float d=shurikenShape(blade),body=1.0-smoothstep(-aa,aa,d);
    float edge=bell(d,.013+aa),soft=bell(d,.045+aa);
    float n=mist(turn(disc,-age*1.7)*5.5+seed);
    float ribs=bell(min(abs(blade.x),abs(blade.y)),.025+aa)*body;
    // Four straight, sharp luminous points remain readable inside their circular motion.
    vec3 light=mix(vec3(.14,.64,1.0),vec3(.72,.97,1.0),.45+.25*n)*body;
    light+=vec3(.67,.96,1.0)*edge*.55+vec3(.025,.47,1.0)*soft*.35;
    light+=vec3(.40,.82,1.0)*ribs*.28;
    for(int i=0;i<4;i++){
      float f=float(i),theta=spin+f*1.57079633;
      float delta=a-theta,arc=atan(sin(delta),cos(delta));
      float u=sat(-arc/1.35),gate=smoothstep(-1.35,-1.10,arc)*(1.0-smoothstep(-.015,.06,arc));
      float radius=.95-u*.21,width=(.035+.035*u)*(1.0-u*.6);
      float nTrail=mist(vec2(r*12.0-age*3.0,arc*4.0+f+seed));
      float tail=bell(r-radius,width+aa)*gate*(1.0-u)*(.45+.55*nTrail);
      float rim=bell(r-radius-width*.30,.009+aa)*gate*(1.0-u);
      float near=.62+.38*sat(.5-disc.y);
      light+=vec3(.025,.44,1.0)*tail*near*.9+vec3(.60,.95,1.0)*rim*near*.65;
      // Short shutter streak on the cutting edge, not another full ghost star.
      float old=shurikenShape(turn(disc,-spin+.10+f*.035));
      light+=vec3(.055,.39,.94)*bell(old,.012+aa)*(.085-f*.012);
    }
    // Separate pressure wisps at unequal radii, with broken ends and visible gaps.
    for(int i=0;i<7;i++){
      float f=float(i),s=hash21(vec2(f+89.0,seed)),theta=age*(6.0+s*3.0)+f*2.399963;
      float delta=a-theta,arc=atan(sin(delta),cos(delta));
      float u=(arc+.8)/1.1,gate=smoothstep(0.0,.25,u)*(1.0-smoothstep(.55,1.0,u));
      float rr=.98+s*.14+arc*.05;
      float cut=bell(r-rr,.009+aa)*gate*(.35+.65*s);
      float haze=bell(r-rr,.045)*gate*.09;
      light+=vec3(.18,.68,1.0)*cut*.60+vec3(.015,.35,.8)*haze;
    }
    for(int i=0;i<10;i++){
      float f=float(i),u=fract(age*(.65+fract(f*.37)*.3)+f*.173);
      float th=age*4.0+f*2.399963,rr=.68+u*.46;
      vec2 head=vec2(cos(th),sin(th))*rr;
      vec2 tangent=vec2(-sin(th),cos(th));
      vec2 dd=disc-head;
      float spark=bell(dot(dd,tangent),.025+.025*(1.0-u))*bell(dot(dd,head/max(rr,.01)),.006+aa);
      spark*=sin(u*3.141593);
      light+=vec3(.50,.90,1.0)*spark*.75;
    }
    float core=length(disc),pulse=.90+.10*sin(age*23.0);
    light+=vec3(.02,.39,1.0)*bell(core,.24)*.45;
    light+=vec3(.33,.85,1.0)*bell(core,.10)*pulse+.8*vec3(.83,1.0,1.0)*bell(core,.045);
    float wakeT=sat((-p.y-.12)/1.42),wakeGate=smoothstep(0.0,.14,-p.y-.12)*(1.0-smoothstep(.68,1.0,wakeT));
    float wakeWidth=.18*(1.0-wakeT)+.025,wakeX=p.x-sin(wakeT*11.0-age*18.0)*.045*wakeT;
    light+=vec3(.01,.41,.88)*bell(wakeX,wakeWidth)*wakeGate*flight*.55;
    light+=vec3(.28,.85,1.0)*bell(wakeX,wakeWidth*.28+aa)*wakeGate*flight*.4;
    return light*mix(1.0-smoothstep(1.15,1.23,r),1.0,flight);
  }

  vec3 energyShuriken(vec2 q, float age, float seed, float aa) {
    return ninjaFlow(q, age, seed, aa, 0.0);
  }
  vec3 windCrescent(vec2 q, float age, float seed, float aa) {
    // Convex midpoint faces local +X (actual projectile heading). Sharp tips trail behind it.
    float y=q.y/1.04,arch=sqrt(max(0.0,1.0-min(y*y,1.0)));
    float span=1.0-smoothstep(.91,1.0,abs(y));
    float front=-.32+.92*arch,thickness=.29*pow(arch,1.35),d=front-q.x;
    float body=smoothstep(-aa,.012+aa,d)*(1.0-smoothstep(thickness*.66+aa,thickness+aa,d))*span;
    float n=mist(vec2(q.x*6.0-age*4.5+seed,q.y*5.0));
    float edge=bell(d-.009,.018+aa)*span*pow(arch,.4);
    float seam=bell(d-thickness*.66,.014+aa)*body;
    vec3 light=vec3(.025,.57,.32)*body*(.55+.40*n);
    light+=vec3(.69,1.0,.85)*edge*1.15+vec3(.19,.91,.57)*seam*.42;
    light+=vec3(.06,.67,.38)*bell(d,.075+aa)*span*.30;
    // Unequal wisps peel from the curved edge, break up and drift into the wake.
    for(int i=0;i<7;i++){
      float f=float(i),s=hash21(vec2(f+34.0,seed)),lane=(s-.5)*1.6;
      float root=-.32+.92*sqrt(max(0.0,1.0-lane*lane))-.16;
      float len=.40+s*.87,t=sat((root-q.x)/len);
      float yy=lane*(1.0-.26*t)+sin(t*5.0-age*(5.0+s*4.0)+f)*(.018+.075*t);
      float gate=smoothstep(0.0,.09,root-q.x)*(1.0-smoothstep(.32+s*.25,1.0,t));
      float turbulence=mist(vec2(q.x*9.0+age*7.0,yy*11.0+f));
      float streak=bell(q.y-yy,.014+.022*s+.022*(1.0-t)+aa)*gate*(.18+.82*turbulence);
      light+=vec3(.12,.74,.46)*streak*(.26+s*.28);
    }
    // A faint second shear at the trailing edge adds thickness without a second blade.
    light+=vec3(.06,.46,.28)*bell(d-thickness-.045,.024+aa)*span*arch*.22;
    return light;
  }

  vec4 frag () {
    vec2 p = (uv0 - vec2(0.5)) * vec2(fxShape.x, -fxShape.y);
    // Physical-distance falloff, shared by premultiplied wind and additive energy.
    vec2 margin = min(uv0, vec2(1.0) - uv0) * max(fxShape.xy, vec2(1.0));
    vec2 edge = smoothstep(vec2(0.0), vec2(3.0), margin);
    float opacity = sat(fxState.z) * edge.x * edge.y;
    if (opacity <= 0.0) return vec4(0.0);
    float radius = max(fxShape.z, 1.0), age = max(fxState.x, 0.0);
    float seed = hash21(vec2(fxState.y, 19.17)) * TAU;
    float aa = clamp(0.8 / radius, 0.002, 0.035);
    vec4 result;
    if (fxState.w < 0.5) result = windEye(p / radius, age, seed, aa);
    else if (fxState.w < 1.5) result = tornado(p / radius, age, seed, aa);
    else if (fxState.w < 2.5) result = vec4(energyShuriken(p / radius, age, seed, aa), 0.0);
    else if (fxState.w < 3.5) result = vec4(windCrescent(p / radius, age, seed, aa), 0.0);
    else result = vec4(ninjaFlow(p / radius, age, seed, aa, 1.0), 0.0);
    // Host opacity supplies the entry ramp. Projectiles can live less
    // than that and must be readable immediately on their first travel frame.
    float entry = 1.0; // Host opacity already owns entry and exit, including mode 2.
    // fxShape.w is the host duration. The host owns the end fade/lifecycle.
    // fxState.z is the sole parent opacity: do not multiply mirrored color.a
    // or another duration fade. Wind alpha is ONLY shaped volume coverage.
    // Modes 2/3/4 keep exact zero alpha; ONE/ONE_MINUS_SRC_ALPHA is additive.
    return vec4(max(result.rgb, vec3(0.0)) * max(color.rgb, vec3(0.0)) * opacity * entry,
      result.a * opacity * entry);
  }
}%
