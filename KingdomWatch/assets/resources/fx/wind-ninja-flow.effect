CCEffect %{
  techniques:
  - passes:
    - vert: wind-ninja-vs:vert
      frag: wind-ninja-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 0] }
        fxShape: { value: [250, 250, 100, 4] }
}%

CCProgram wind-ninja-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * p;
  }
}%

CCProgram wind-ninja-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  // x: effect age in battle seconds, y: stable seed, z: parent opacity,
  // w: 0 eye / 1 tornado / 2 energy shuriken / 3 local +X crescent.
  uniform HeroFlow {
    vec4 fxState;
    vec4 fxShape;
  };
  const float TAU = 6.28318530718;
  float sat(float x) { return clamp(x, 0.0, 1.0); }
  // Compact polynomial bell: degree six in distance, zero outside width.
  // No exp/pow, texture reads, derivatives, or unbounded glow tails.
  float bell(float d, float width) {
    float v = sat(1.0 - d * d / max(width * width, 0.000001));
    return v * v * (3.0 - 2.0 * v);
  }
  float hash21(vec2 p) {
    vec3 q = fract(vec3(p.x, p.y, p.x) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
  }
  float windNoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),
      mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0)), f.x), f.y);
  }
  float mist(vec2 p) {
    // Exactly two octaves; rotation breaks the lattice's preferred axes.
    return windNoise(p) * 0.666667 + windNoise(mat2(1.6, 1.2, -1.2, 1.6) * p
      + vec2(7.1, 3.7)) * 0.333333;
  }
  vec2 turn(vec2 p, float a) {
    float c = cos(a), s = sin(a);
    return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
  }
  float angleOf(vec2 p) {
    // atan(0,0) is undefined on some mobile GPUs.
    return dot(p, p) > 0.00000001 ? atan(p.y, p.x) : 0.0;
  }

  vec4 windEye(vec2 p, float age, float seed, float aa) {
    vec2 q = p / vec2(1.0, 0.88);
    // Three two-octave fields: large advected billows, their warped detail,
    // and a separately rotating back layer. No noise is sampled in raw angle.
    vec2 advect = turn(q, -age * 0.73) * 2.7 + vec2(seed, -age * 0.36);
    float n = mist(advect);
    float fine = mist(advect * 1.85 + vec2(n * 1.25, 11.3 - age * 0.28));
    float back = mist(turn(q, -age * 0.43) * 3.8 + vec2(17.2, seed - age * 0.31));
    vec2 curl = q + vec2(n - 0.5, back - 0.5) * 0.11;
    float r = length(curl), a = angleOf(curl);
    float boundary = 1.0 - smoothstep(0.73, 1.09, r + (fine - 0.5) * 0.075);
    float dome = sqrt(max(0.0, 1.0 - min(r * r, 1.0)));
    float angularFade = smoothstep(0.045, 0.23, r);
    float swirl = 0.5 + 0.5 * sin(a * 2.0 + r * 6.4 - age * 2.35 + seed
      + (n - 0.5) * 2.9);
    float counterflow = 0.5 + 0.5 * sin(a * 3.0 - r * 4.6 - age * 1.65
      + seed + (back - 0.5) * 2.6);
    swirl = mix(0.5, swirl, angularFade);
    counterflow = mix(0.5, counterflow, angularFade);
    // Broad spiral folds carry the volume; narrow highlights are secondary.
    float folds = swirl * swirl * (0.45 + fine * 0.55);
    float backFolds = counterflow * counterflow * (0.35 + back * 0.65);
    float nearFace = 0.5 + 0.5 * sin(a + 0.7) * angularFade;
    float density = boundary * (0.055 + n * 0.075 + folds * 0.12
      + backFolds * 0.07) * (0.77 + dome * 0.23);
    float broadBands = 0.0;
    vec3 emission = vec3(0.005, 0.29, 0.43) * folds * boundary * (0.36 + dome * 0.34);
    emission += vec3(0.008, 0.17, 0.32) * backFolds * boundary * 0.46;
    // A continuous inward spiral with grouped fine fibers, rather than separated wire rings.
    float flowPhase = a * 3.0 + log(0.18 + r) * 10.5 - age * 4.5 + seed + (n - 0.5) * 1.3;
    float flow = 0.5 + 0.5 * cos(flowPhase);
    float streams = flow * flow * flow * angularFade;
    float fibers = bell(1.0 - cos(flowPhase * 4.0 + fine * 1.8), 0.16 + aa) * angularFade;
    emission += vec3(0.008, 0.54, 0.66) * streams * (0.42 + fine * 0.44);
    emission += vec3(0.26, 0.80, 0.90) * fibers * streams * (0.38 + nearFace * 0.22);
    for (int i = 0; i < 4; i++) {
      float k = float(i), head = age * (1.12 + k * 0.17) + seed + k * 2.17;
      float ca = cos(a - head), sa = sin(a - head);
      float arc = smoothstep(-0.52, 0.85, ca)
        * (0.3 + 0.7 * smoothstep(-0.8, 0.65, sa)) * angularFade;
      float track = 0.22 + k * 0.19 + sa * (0.14 + k * 0.017)
        + sin(a * 2.0 + head * 0.6) * 0.065 + (n - 0.5) * 0.11;
      float width = 0.11 + k * 0.018 + fine * 0.045;
      float d = r - track;
      float ribbon = bell(d, width) * arc;
      float crest = bell(d + width * 0.28, width * 0.25 + aa) * arc;
      float broken = smoothstep(0.26, 0.77, fine * 0.65 + back * 0.35);
      broadBands += ribbon;
      emission += vec3(0.015, 0.40, 0.59) * ribbon * (0.30 + nearFace * 0.28);
      emission += vec3(0.38, 0.88, 1.0) * crest * broken * 0.62;
    }
    float alpha = min(0.35, density + broadBands * boundary * 0.045);
    vec3 pigment = mix(vec3(0.008, 0.25, 0.34), vec3(0.022, 0.47, 0.59),
      sat(fine * 0.55 + dome * 0.25 + nearFace * 0.2));
    emission += vec3(0.015, 0.39, 0.56) * bell(r, 0.29) * (0.08 + n * 0.12);
    // True premultiplied colored volume + coverage-weighted emitted light.
    return vec4(pigment * alpha + emission * boundary, alpha);
  }

  vec4 tornado(vec2 q, float age, float seed, float aa) {
    // Keep the original LOCAL base/crown and host .35r offset. This revision
    // changes only appearance, not standalone timing, motion, or physics.
    float height = (q.y + 1.10) / 2.48, h = sat(height);
    vec2 advect = vec2(q.x * (3.6 - h * 1.1) + seed
      + sin(h * 5.0 - age * 0.9) * 0.32, height * 5.4 - age * 1.04);
    float n = mist(advect);
    float fine = mist(advect * 1.75 + vec2(n * 1.2, 9.1 - age * 0.22));
    float back = mist(vec2(q.x * 3.2 + 13.1, height * 4.6 - age * 0.77 + seed));
    float vertical = smoothstep(0.0, 0.065, height)
      * (1.0 - smoothstep(0.88, 1.0, height + (fine - 0.5) * 0.04));
    float center = sin(h * 4.2 - age * 0.85 + seed) * (0.025 + h * 0.055)
      + sin(h * 8.0 - age * 1.25 + seed) * h * 0.022;
    float width = (0.105 + 0.82 * (0.72 * h + 0.28 * h * h)) * (0.94 + n * 0.12);
    float x = (q.x - center) / width;
    float inside = 1.0 - smoothstep(0.72, 1.16, abs(x) + (fine - 0.5) * 0.14);
    float depth = sqrt(max(0.0, 1.0 - min(x * x, 1.0)));
    float frontAngle = atan(clamp(x, -1.0, 1.0), max(depth, 0.0001));
    float backAngle = atan(clamp(x, -1.0, 1.0), -max(depth, 0.0001));
    // Wide helicoidal sheets across a full translucent chord. Two unequal
    // pitches and advected domain warp interrupt the regular coil structure.
    // Integer angular harmonics remain continuous at the back-surface seam.
    float frontPhase = frontAngle * 2.0 - h * 32.3 + age * 6.3 + seed
      + (n - 0.5) * 3.2 + sin(h * 5.0 - age * 1.15) * 0.85;
    float backPhase = backAngle * 3.0 - h * 26.4 + age * 5.15 + seed
      + (back - 0.5) * 2.8;
    float frontRoll = 0.5 + 0.5 * cos(frontPhase);
    float backRoll = 0.5 + 0.5 * cos(backPhase);
    frontRoll = frontRoll * frontRoll * (0.42 + fine * 0.58);
    backRoll = backRoll * backRoll * (0.35 + back * 0.65);
    float mask = inside * vertical;
    float bodyAlpha = min(0.33, mask * (0.07 + depth * 0.075 + n * 0.065
      + frontRoll * 0.10 + backRoll * 0.055));
    vec3 emission = vec3(0.015, 0.62, 0.76) * frontRoll * (0.60 + depth * 0.70);
    emission += vec3(0.008, 0.34, 0.49) * backRoll * 0.62;
    float filaments = bell(1.0 - cos(frontPhase * 2.0 + fine * 1.2), 0.17 + aa);
    float breaks = smoothstep(0.3, 0.8, fine * 0.7 + n * 0.3);
    emission += vec3(0.38, 0.91, 1.0) * filaments * (0.45 + breaks * 0.55) * (0.18 + depth * 0.52);
    emission *= mask;
    // The top rolls over into a broad, turbulent elliptical crown. Its interior
    // is mist-filled, and its two broken curls never form a closed rim line.
    vec2 crown = vec2((q.x - center * 0.5) / 0.94, (q.y - 1.035) / 0.27);
    float crownR = length(crown), crownA = angleOf(crown);
    float crownMask = 1.0 - smoothstep(0.57, 1.12, crownR + (fine - 0.5) * 0.12);
    float crownAngular = smoothstep(0.04, 0.25, crownR);
    float crownFlow = 0.5 + 0.5 * sin(crownA * 2.0 + crownR * 3.8
      - age * 2.9 + seed + (n - 0.5) * 2.0);
    crownFlow = mix(0.5, crownFlow, crownAngular);
    float crownAlpha = crownMask * (0.065 + crownFlow * 0.095 + fine * 0.055);
    float crownArc = bell(crownR - 0.58 - sin(crownA * 2.0 - age * 1.1) * 0.12, 0.24)
      * smoothstep(-0.3, 0.85, cos(crownA - age * 1.55 - seed)) * crownAngular;
    emission += vec3(0.012, 0.34, 0.51) * crownMask * crownFlow * (0.22 + fine * 0.22);
    emission += vec3(0.27, 0.83, 0.96) * crownArc * crownMask * (0.32 + breaks * 0.35);
    vec2 baseCurl = vec2(q.x / 0.43, (q.y + 1.005) / 0.12);
    float baseR = length(baseCurl), baseA = angleOf(baseCurl);
    float baseFlow = bell(baseR - 0.7, 0.3) * (0.4 + 0.6 * sin(baseA * 2.0 - age * 4.0) * sin(baseA * 2.0 - age * 4.0));
    emission += vec3(0.015, 0.40, 0.52) * baseFlow * 0.65;
    float alpha = min(0.35, bodyAlpha + crownAlpha * (1.0 - bodyAlpha));
    vec3 pigment = mix(vec3(0.008, 0.25, 0.36), vec3(0.025, 0.46, 0.59),
      sat(n * 0.4 + depth * 0.35 + frontRoll * 0.25));
    vec3 light = pigment * alpha + emission;
    // Four individually staggered rising fragments, still zero at birth/wrap.
    for (int i = 0; i < 4; i++) {
      float k = float(i), s = hash21(vec2(k + 2.0, seed));
      float u = fract(age * (0.32 + s * 0.07) + s);
      float phase = seed + k * 2.4 + age * 2.1;
      float spread = 0.16 + 0.88 * u * u;
      vec2 pos = vec2(sin(phase) * spread, -1.12 + u * 2.58);
      vec2 direction = normalize(vec2(cos(phase) * spread * 1.4, 1.0));
      vec2 d = q - pos;
      float life = smoothstep(0.0, 0.16, u) * (1.0 - smoothstep(0.72, 1.0, u));
      float fragment = bell(dot(d, vec2(-direction.y, direction.x)), 0.013 + aa)
        * bell(dot(d, direction), 0.065 + u * 0.055) * life;
      light += vec3(0.16, 0.78, 1.0) * fragment * (0.25 + s * 0.25);
    }
    return vec4(light, alpha);
  }

  float shurikenShape(vec2 q) {
    vec2 b = abs(q);
    // Four long straight tips, with deep concave notches and sharp cutting edges.
    return (max(b.x,b.y) + 2.6 * min(b.x,b.y) - 0.93) / 2.786;
  }
  vec3 energyShuriken(vec2 q, float age, float seed, float aa) {
    float r=length(q),a=angleOf(q),spin=age*6.6+seed;
    vec2 bladePoint=turn(q,-spin);
    float distance=shurikenShape(bladePoint);
    float aperture=smoothstep(0.10-aa,0.14+aa,r);
    float body=(1.0-smoothstep(-aa,aa,distance))*aperture;
    float edge=bell(distance,0.018+aa)*aperture;
    float n=mist(bladePoint*9.0+vec2(seed,-age*1.4));
    float veins=bell(sin(r*37.0-age*13.0+n*3.0),0.12+aa)*body;
    vec3 light=vec3(0.015,0.29,0.82)*body*(0.50+n*0.30);
    light+=vec3(0.50,0.91,1.0)*edge*0.86;
    light+=vec3(0.13,0.63,0.95)*veins*0.18;
    light+=vec3(0.03,0.34,0.85)*bell(distance,0.065+aa)*aperture*0.15;
    // The hollow energy aperture remains readable; no overexposed central white hub.
    light+=vec3(0.14,0.72,1.0)*bell(r-0.125,0.014+aa)*0.45;
    for(int i=0;i<3;i++) {
      float k=float(i),lag=0.11+k*0.12;
      float d=shurikenShape(turn(q,-spin+lag));
      float ghost=bell(d,0.02+k*0.01+aa)*aperture*(1.0-body*0.8);
      light+=vec3(0.015,0.33,0.90)*ghost*(0.36/(1.0+k));
    }
    float shearPhase=a*5.0+log(0.2+r)*12.0-age*9.0+n*3.0;
    float shear=0.5+0.5*cos(shearPhase);
    float skirt=bell(r-0.72,0.38)*(1.0-body*0.82)*shear*shear*shear;
    light+=vec3(0.006,0.05,0.16)*skirt*(0.45+n*0.55);
    // Tangential wind shear and small sparks accent the spinning weapon, not replace its silhouette.
    for(int i=0;i<8;i++) {
      float k=float(i),u=fract(age*(0.48+0.04*mod(k,3.0))+k*0.137);
      float theta=seed+k*2.39996+age*1.65;
      vec2 outward=vec2(cos(theta),sin(theta)),tangent=vec2(-outward.y,outward.x);
      vec2 offset=q-outward*(0.63+u*0.47);
      float life=sin(u*3.14159265);
      float spark=bell(dot(offset,outward),0.007+aa)*bell(dot(offset,tangent),0.035+u*0.065)*life;
      light+=vec3(0.23,0.65,1.0)*spark*0.7;
    }
    return light*(1.0-smoothstep(1.10,1.19,r));
  }

  vec3 windCrescent(vec2 q, float age, float seed, float aa) {
    // Local +X points at the enemy. A bowed convex right edge and a deeper
    // concave left edge form a strong lunate cutter with two sharp tapered tips.
    float y = q.y / 1.03, y2 = y * y;
    float span = 1.0 - smoothstep(0.86, 1.0, abs(y));
    float arch = sqrt(max(0.0, 1.0 - min(y2, 1.0)));
    float front = -0.13 + arch * 0.71;
    float thickness = 0.36 * arch * arch;
    float d = front - q.x;
    float n = mist(vec2(q.x * 4.0 - age * 2.0 + seed, q.y * 3.4));
    float body = smoothstep(-aa, 0.035 + aa, d)
      * (1.0 - smoothstep(thickness * 0.5 + aa, thickness + aa * 2.0, d));
    body *= arch * span;
    float edge = bell(d - 0.014, 0.025 + aa) * arch * span;
    float outerGlow = bell(d, 0.10 + aa) * arch * span;
    vec3 light = vec3(0.025, 0.51, 0.34) * body * (0.5 + n * 0.36);
    light += vec3(0.19, 0.83, 0.58) * outerGlow * 0.27;
    light += vec3(0.73, 1.0, 0.88) * edge * 0.9;
    // Narrow streaks stream behind the concave opening in -X; staggered moving
    // packets have zero coverage at their wrap, rather than flashing hash cells.
    for (int i = 0; i < 4; i++) {
      float k = float(i), s = hash21(vec2(k + 57.0, seed));
      float u = fract(age * (1.15 + s * 0.25) + s);
      float lane = (k - 1.5) * 0.42;
      float x = -0.10 - u * 1.12;
      float sweep = lane * (0.72 + u * 0.28) + sin(u * 3.0 + seed + k) * 0.065;
      vec2 dTrail = q - vec2(x, sweep);
      float taper = 1.0 - u;
      float streak = bell(dTrail.y, 0.016 + taper * 0.018 + aa)
        * bell(dTrail.x, 0.09 + taper * 0.17);
      streak *= smoothstep(0.0, 0.13, u) * (1.0 - smoothstep(0.65, 1.0, u));
      light += vec3(0.12, 0.68, 0.46) * streak * 0.5;
    }
    return light;
  }

  vec4 frag () {
    vec2 p = (uv0 - vec2(0.5)) * vec2(fxShape.x, -fxShape.y);
    // Physical-distance falloff, shared by premultiplied wind and additive energy.
    vec2 margin = min(uv0, vec2(1.0) - uv0) * max(fxShape.xy, vec2(1.0));
    vec2 edge = smoothstep(vec2(0.0), vec2(3.0), margin);
    float opacity = sat(fxState.z) * edge.x * edge.y;
    if (opacity <= 0.0) return vec4(0.0);
    float radius = max(fxShape.z, 1.0), age = max(fxState.x, 0.0);
    float seed = hash21(vec2(fxState.y, 19.17)) * TAU;
    float aa = clamp(0.8 / radius, 0.002, 0.035);
    vec4 result;
    if (fxState.w < 0.5) result = windEye(p / radius, age, seed, aa);
    else if (fxState.w < 1.5) result = tornado(p / radius, age, seed, aa);
    else if (fxState.w < 2.5) result = vec4(energyShuriken(p / radius, age, seed, aa), 0.0);
    else result = vec4(windCrescent(p / radius, age, seed, aa), 0.0);
    // Only the area modes have a .16s entry ramp. Projectiles can live less
    // than that and must be readable immediately on their first travel frame.
    float entry = fxState.w < 2.5 ? smoothstep(0.0, 0.16, age) : 1.0;
    // fxShape.w is the host duration. The host owns the end fade/lifecycle.
    // fxState.z is the sole parent opacity: do not multiply mirrored color.a
    // or another duration fade. Wind alpha is ONLY shaped volume coverage.
    // Modes 2/3 keep exact zero alpha, so ONE/ONE_MINUS_SRC_ALPHA is additive.
    return vec4(max(result.rgb, vec3(0.0)) * max(color.rgb, vec3(0.0)) * opacity * entry,
      result.a * opacity * entry);
  }
}%
