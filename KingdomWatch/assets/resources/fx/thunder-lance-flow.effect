CCEffect %{
  techniques:
  - passes:
    - vert: thunder-lance-vs:vert
      frag: thunder-lance-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 0] }
        fxShape: { value: [250, 250, 100, 0] }
}%
CCProgram thunder-lance-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p=vec4(a_position,1.0);
    #if USE_LOCAL
      p=cc_matWorld*p;
    #endif
    uv0=a_texCoord;color=a_color;return cc_matViewProj*p;
  }
}%
CCProgram thunder-lance-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  uniform LanceFlow { vec4 fxState; vec4 fxShape; };
  const float TAU=6.28318530718;
  const vec3 GOLD=vec3(1.,.57,.055),YELLOW=vec3(1.,.86,.25),CORE=vec3(1.,.99,.84);
  float sat(float v){return clamp(v,0.,1.);}
  float hash(float v){return fract(sin(v*127.1)*43758.5453);}
  float noise(float p){float i=floor(p),f=fract(p);return mix(hash(i),hash(i+1.),f*f*(3.-2.*f));}
  float line(float d,float w){return exp(-d*d/max(w*w,.000001));}
  float jag(float p){float i=floor(p);return mix(hash(i),hash(i+1.),fract(p));}
  float trunk(float y,float seed){return ((jag((y+.5)*19.+seed)-.5)*.024+(jag((y+.5)*8.+seed+73.)-.5)*.016)*sin(clamp(y+.5,0.,1.)*3.14159265);}
  float branchSegment(vec2 p,vec2 a,vec2 b){vec2 d=b-a;return length(p-a-d*clamp(dot(p-a,d)/max(.000001,dot(d,d)),0.,1.));}
  float hash2(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
  float valueNoise2(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash2(i),hash2(i+vec2(1.,0.)),f.x),mix(hash2(i+vec2(0.,1.)),hash2(i+1.),f.x),f.y);}
  float fog(vec2 p){return valueNoise2(p)*.65+valueNoise2(p*2.13+17.2)*.25+valueNoise2(p*4.47-9.3)*.1;}
  vec4 frag(){
    vec2 q=(vec2(uv0.x,.999999-uv0.y)-.5)*fxShape.xy/max(fxShape.z,1.);
    float time=fxState.x,seed=fxState.y*37.,power=fxState.z,mode=fxState.w;
    vec3 rgb=vec3(0.);float alpha=0.;
    if(mode<.5){
      float y=q.y,mask=smoothstep(-.53,-.49,y)*(1.-smoothstep(.496,.506,y));
      float path=trunk(y,seed),d=q.x-path;
      // A solid energy weapon with a broad shoulder and taper, not a single needle line.
      float width=(.034+.006*jag(y*18.+seed))*(1.-smoothstep(.18,.505,y)*.91);
      width+=.038*smoothstep(.04,.15,y)*(1.-smoothstep(.16,.49,y));
      float charge=.82+.18*sin(y*47.-time*31.+seed),shaft=line(d,width)*mask;
      rgb=(GOLD*shaft*.7+YELLOW*line(d,width*.70)*.7+CORE*line(d-width*.13,width*.30)*mask)*mask*charge;
      alpha=shaft*.91;
      rgb+=GOLD*line(d,.095)*mask*.30;
      // Uneven angular electrical strands hug the shaft, adding mass without long antlers.
      for(int j=0;j<3;j++){
        float fj=float(j),phase=y*(17.+fj*4.)-time*(5.+fj)+seed+fj*13.;
        float coil=((jag(phase)-.5)*.78+(jag(phase*3.17+7.)-.5)*.22)*(.12+fj*.018);
        float envelope=smoothstep(-.48,-.31,y)*(1.-smoothstep(.28,.46,y));
        float filament=line(d-coil,.0045+fj*.001)*envelope;
        rgb+=(YELLOW*.6+CORE*.48)*filament;
        rgb+=GOLD*line(d-coil,.019)*envelope*.13;
      }
      for(int i=0;i<3;i++){
        float fi=float(i),rootY=-.31+fi*.23+(hash(fi+seed)-.5)*.07;
        float side=mod(fi,2.)<.5?-1.:1.,reach=(.065+hash(fi*11.+seed)*.05)*side;
        vec2 root=vec2(trunk(rootY,seed),rootY);
        vec2 knee=root+vec2(reach*.42,.025+hash(fi+27.)*.02);
        vec2 joint=root+vec2(reach*.68,.03+hash(fi+51.)*.025);
        vec2 tip=root+vec2(reach,.07+hash(fi+83.)*.035);
        float branch=min(branchSegment(q,root,knee),min(branchSegment(q,knee,joint),branchSegment(q,joint,tip)));
        float taper=1.-sat(length(q-root)/.13)*.7,pulse=.52+.28*sin(time*23.-fi*2.3);
        rgb+=(YELLOW*line(branch,.0035)+CORE*line(branch,.0013)*.65)*taper*pulse;
        rgb+=GOLD*line(branch,.012)*taper*.12;
        if(fi<.5){
          vec2 fork=knee+vec2(reach*.3,-.02);
          float twig=branchSegment(q,knee,fork);
          rgb+=YELLOW*line(twig,.003)*pulse*.65;
        }
      }
      float trail=smoothstep(-.82,-.62,y)*(1.-smoothstep(-.5,-.32,y));
      rgb+=GOLD*line(q.x+sin(y*37.+time*27.)*.02,.07)*trail*.36;
      rgb+=CORE*line(y+.17,.035)*line(d,.09)*(.18+.12*sin(time*11.+seed));
      // The submerged section is clipped, including its bloom, before the foreground soil lip.
      if(fxShape.w>0.00001){float visible=1.-smoothstep(.5-fxShape.w-.003,.5-fxShape.w+.002,y);rgb*=visible;alpha*=visible;}
    }else if(mode>3.5){
      // Compressed flash -> expanding lobed thunder blast -> branching after-arcs.
      float t=fxShape.w,r=length(q),a=atan(q.y,q.x),expand=.08+.7*(1.-pow(1.-sat(t*2.3),2.));
      float lobe=(fog(q*7.+seed)-.5)*.24;
      float cloud=1.-smoothstep(expand-.12,expand+.04,r+lobe);
      float hot=line(r,.09+t*.25)*pow(1.-t,3.);
      float skin=line(r+lobe-expand,.025)*(1.-t)*(1.-t);
      rgb=GOLD*cloud*.32*(1.-t)+YELLOW*skin*.9+CORE*(hot*2.+cloud*pow(1.-t,7.)*1.2);
      float vapor=fog(q*6.-vec2(time*.7,time*1.4)+seed);
      rgb+=GOLD*vapor*cloud*(1.-t)*.42;
      alpha=cloud*vapor*(1.-t)*.24;
      for(int k=0;k<7;k++){
        float fk=float(k),angle=hash(seed+fk*13.)*TAU,reach=.45+hash(fk+seed+19.)*.45;
        vec2 dir=vec2(cos(angle),sin(angle)),side=vec2(-dir.y,dir.x);
        vec2 root=dir*(.12+t*.22),bend=dir*(reach*.6+t*.13)+side*(hash(fk+23.)-.5)*.27;
        vec2 tip=dir*(reach+t*.22)+side*(hash(fk+31.)-.5)*.20;
        vec2 knee=mix(root,bend,.44)+side*(hash(fk+seed+43.)-.5)*.13;
        vec2 joint=mix(bend,tip,.56)+side*(hash(fk+seed+57.)-.5)*.10;
        float bolt=min(min(branchSegment(q,root,knee),branchSegment(q,knee,bend)),
          min(branchSegment(q,bend,joint),branchSegment(q,joint,tip)));
        if(k<2)bolt=min(bolt,branchSegment(q,bend,bend+dir*.13+side*.16));
        rgb+=(CORE*.85+YELLOW*.4)*line(bolt,.005)*pow(1.-t,2.5);
      }
      for(int k=0;k<10;k++){
        float fk=float(k),angle=hash(seed+fk*19.+3.)*TAU;
        vec2 dir=vec2(cos(angle),sin(angle));
        float speed=.4+hash(fk+seed+23.)*.75;
        vec2 spark=q-dir*(.07+sqrt(sat(t))*speed)-vec2(0.,t*.16);
        float d=branchSegment(spark,-dir*.014,dir*.014);
        rgb+=(CORE+YELLOW*.4)*line(d,.008)*pow(1.-t,1.3);
      }
      rgb+=YELLOW*line(q.y,.008)*line(q.x,.8)*pow(1.-t,5.)*.8;
    }else{
      vec2 p=vec2(q.x,q.y/.58);float r=length(p),a=atan(p.y,p.x),t=fxShape.w;
      vec2 direction=p/max(.001,r);
      float terrain=fog(p*5.3+seed),drift=fog(p*7.+vec2(time*.3,-time*.22)+seed);
      if(mode<1.5){
        // A low, shifting electric haze; independent ground branches are drawn in code.
        float pool=(1.-smoothstep(.12,.70,r+(terrain-.5)*.35));
        float hot=line(r,.12)*(.38+.12*sin(time*9.+seed));
        rgb=GOLD*pool*drift*.20+YELLOW*hot*.28+CORE*hot*.20;
        float veins=line(terrain-.54,.015)*smoothstep(.48,.63,drift)*(1.-smoothstep(.22,.8,r));
        rgb+=YELLOW*veins*.22;
      }else if(mode<2.5){
        float radius=.08+.91*(1.-pow(1.-sat(t),1.6));
        float lobes=(valueNoise2(direction*3.7+seed)-.5)*.25,warp=(valueNoise2(p*22.+seed)-.5)*.045;
        float d=r-radius-lobes;
        // Broad gaps, independently advancing lobes and a soft pressure front replace the closed ring.
        float gaps=smoothstep(.45,.62,valueNoise2(direction*5.7+seed+9.));
        float shards=line(d+warp,.012)*gaps*(1.-t);
        float pressure=line(d+.07,.10)*(.25+.75*terrain)*(1.-t)*.20;
        rgb=CORE*shards*.95+YELLOW*shards*.45+GOLD*pressure;
        float echo=line(d+.13,.024)*smoothstep(.56,.70,valueNoise2(direction*8.3-seed))*(1.-t)*.5;
        rgb+=YELLOW*echo;
        for(int k=0;k<5;k++){
          float fk=float(k),angle=hash(seed+fk*17.)*TAU;
          vec2 dir=vec2(cos(angle),sin(angle)),side=vec2(-dir.y,dir.x);
          vec2 root=dir*(radius*.78),mid=dir*(radius+.02)+side*(hash(fk+seed)-.5)*.16;
          vec2 tip=dir*(radius+.12)+side*(hash(fk+seed+7.)-.5)*.26;
          float tear=min(branchSegment(p,root,mid),branchSegment(p,mid,tip));
          rgb+=YELLOW*line(tear,.007)*pow(1.-t,1.6)*.55;
        }
      }else{
        float fragments=line(terrain-.52,.016)*smoothstep(.48,.65,drift)*(1.-smoothstep(.35,.82,r));
        rgb=YELLOW*fragments*.28+GOLD*line(r,.18)*(.2+.25*t);
      }
      rgb*=1.-smoothstep(1.05,1.19,r);
    }
    float edge=smoothstep(0.,.025,uv0.x)*smoothstep(0.,.025,uv0.y)*smoothstep(0.,.025,1.-uv0.x)*smoothstep(0.,.025,1.-uv0.y);
    return vec4(rgb*power*edge,alpha*power*edge)*color;
  }
}%
