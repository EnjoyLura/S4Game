CCEffect %{
  techniques:
  - passes:
    - vert: hero-flow-vs:vert
      frag: hero-flow-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 0] }
        fxShape: { value: [320, 320, 100, 0] }
  - passes:
    - vert: hero-flow-vs:vert
      frag: hero-flow-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 2] }
        fxShape: { value: [320, 120, 248, 0] }
  - passes:
    - vert: hero-flow-vs:vert
      frag: hero-flow-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        fxState: { value: [0, 1, 1, 2] }
        fxShape: { value: [320, 144, 248, 0] }
}%
CCProgram hero-flow-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * p;
  }
}%
CCProgram hero-flow-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  uniform HeroFlow {
    vec4 fxState;
    vec4 fxShape;
  };
  float sat(float x) { return clamp(x, 0.0, 1.0); }
  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
      mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0)), f.x), f.y);
  }
  float fbm(vec2 p) {
    float n = noise(p) * 0.57;
    p = mat2(1.6, 1.2, -1.2, 1.6) * p + vec2(7.1, 3.7);
    return n + noise(p) * 0.28 + noise(p * 2.03 + vec2(2.3)) * 0.15;
  }
  float soft(float d, float w) { return exp(-d * d / max(0.01, w * w)); }
  vec4 explosion(vec2 p, float age, float seed, float radius, float power) {
    // Smoke and emissive flame share one bounded quad, but have separate evolution and opacity.
    float rise = age * radius * 0.38;
    vec2 q = vec2(p.x, p.y - radius * 0.18 - rise);
    float grow = 1.0 - exp(-age * 32.0);
    vec2 turbulence = vec2(fbm(q / radius * 4.0 + vec2(seed, -age * 3.1)),
      fbm(q / radius * 5.0 + vec2(13.7 + seed, -age * 2.4))) - vec2(0.5);
    vec2 warped = q + turbulence * radius * (0.22 + age * 0.12);
    float field = length(warped / (radius * vec2(0.43, 0.39) * (0.3 + grow * 0.7)));
    float erosion = fbm(q / radius * 8.0 + vec2(seed * 2.3, -age * 4.0));
    float fireLife = 1.0 - smoothstep(0.13, 0.54, age);
    float flame = sat((1.0 - field) * 2.1 + (erosion - 0.52) * 2.7) * fireLife;
    float hot = pow(sat(1.0 - field * 2.5), 2.0) * fireLife;
    float temperature = sat((1.0 - field) * 0.72 + erosion * 0.38);
    vec3 fire = mix(vec3(0.34, 0.035, 0.008), vec3(1.0, 0.27, 0.015), sat(flame * 1.35));
    fire = mix(fire, vec3(1.0, 0.73, 0.12), temperature * temperature * fireLife);
    fire = mix(fire, vec3(1.0, 0.97, 0.73), hot * (0.78 + power * 0.1));
    // Three unequal curling tongues peel away instead of retaining a circular explosion silhouette.
    float tongues = 0.0;
    for (int i = 0; i < 3; i++) {
      float k = float(i), phase = seed + k * 2.17;
      vec2 c = vec2(sin(phase) * radius * 0.25, radius * (0.17 + age * (0.5 + k * 0.13)));
      vec2 v = p - c;
      float a = atan(v.y, v.x), rr = radius * (0.13 + age * 0.21 + k * 0.025);
      float sweep = pow(max(0.0, cos(a - phase - age * 5.0)), 4.0);
      float d = length(v * vec2(1.0, 0.8)) - rr - sin(a * 2.0 + phase) * radius * 0.025;
      tongues += soft(d, radius * (0.026 + 0.018 * (1.0 - sat(age * 2.0)))) * sweep;
    }
    tongues *= (1.0 - smoothstep(0.25, 0.78, age)) * smoothstep(0.015, 0.11, age);
    float smokeNoise = mix(erosion, turbulence.x + 0.5, 0.6);
    float smoke = sat(1.0 - length((q + turbulence * radius * 0.36) /
      (radius * vec2(0.5 + age * 0.2, 0.32 + age * 0.22)))) * (0.5 + smokeNoise * 0.5);
    smoke *= smoothstep(0.08, 0.25, age) * (1.0 - smoothstep(0.5, 1.2, age)) * 0.38;
    float flash = soft(length(p * vec2(0.8, 1.1)), radius * 0.22) * exp(-age * 38.0);
    float flameAlpha = sat(flame * 2.0 + tongues * 0.9 + flash);
    vec3 rgb = mix(vec3(0.14, 0.13, 0.15) + smokeNoise * 0.12, fire, flameAlpha);
    rgb += vec3(1.0, 0.62, 0.14) * tongues + vec3(1.0, 0.95, 0.7) * flash;
    float glow = soft(length(q), radius * 0.62) * fireLife * 0.08;
    rgb += vec3(1.0, 0.25, 0.01) * glow;
    return vec4(rgb, sat(flameAlpha * 0.94 + smoke + glow));
  }
  vec4 ground(vec2 p, float age, float seed, float radius, float life) {
    vec2 q = p / vec2(1.0, 0.43);
    float r = length(q), a = atan(q.y, q.x);
    float appear = smoothstep(0.0, 0.075, age);
    float hold = 1.0 - smoothstep(max(0.5, life - 0.8), life, age);
    float grit = noise(q / radius * 12.0 + vec2(seed * 3.7));
    float roughRadius = radius * (0.55 + 0.035 * sin(a * 3.0 + seed) + 0.022 * sin(a * 7.0 - seed));
    float cavity = (1.0 - smoothstep(roughRadius * 0.78, roughRadius, r)) * appear;
    float lip = soft(r - roughRadius, radius * 0.047) * appear;
    float outer = soft(r - roughRadius * 1.12, radius * 0.065) * appear;
    float light = 0.38 + 0.62 * sat(-q.x / max(1.0, r) * 0.5 + q.y / max(1.0, r) * 0.7 + 0.4);
    vec3 earth = mix(vec3(0.115, 0.075, 0.045), vec3(0.23, 0.16, 0.09), grit * 0.55);
    earth = mix(earth, mix(vec3(0.22, 0.13, 0.065), vec3(0.62, 0.43, 0.23), light), sat(lip + outer * 0.4));
    // The deformation is anchored to the landing, including its noise; it never scrolls or rotates.
    float fracture = pow(max(0.0, sin(a * 5.0 + seed + sin(r / radius * 12.0) * 0.55)), 28.0);
    fracture *= smoothstep(radius * 0.09, radius * 0.19, r) * (1.0 - smoothstep(radius * 0.35, radius * 0.57, r));
    fracture *= (1.0 - smoothstep(0.25, 1.5, age)) * appear;
    float travel = 1.0 - exp(-age * 10.0), ring = radius * (0.12 + travel * 0.98);
    float pressure = soft(r - ring, 2.5 + age * 3.0) * exp(-age * 7.0) * (0.45 + grit * 0.55);
    float dust = soft(r - ring * 0.92, radius * 0.09) * exp(-age * 6.0) * (0.4 + grit * 0.4);
    earth = mix(earth, vec3(1.0, 0.48, 0.055), sat(fracture * 0.9));
    earth = mix(earth, vec3(0.76, 0.57, 0.32), sat(pressure + dust));
    float alpha = (cavity * (0.4 + grit * 0.08) + lip * 0.52 + outer * 0.17) * hold;
    return vec4(earth, sat(alpha + fracture * 0.62 + pressure * 0.55 + dust * 0.16));
  }
  vec4 siphon(vec2 p, float time, float seed, float power, float lengthX) {
    float station = p.x + lengthX * 0.5;
    float u = station / max(1.0, lengthX), t = clamp(u, 0.0, 1.0);
    float envelope = sin(t * 3.141593);
    float within = smoothstep(-3.0, 5.0, station) * (1.0 - smoothstep(lengthX - 5.0, lengthX + 3.0, station));
    float bend = min(24.0, lengthX * 0.04) * sin(seed * 1.7 + 0.6);
    float centre = envelope * (bend + sin(station * 0.018 + time * 1.8 + seed) * 5.0);
    float d = p.y - centre;
    // Moving pressure pockets travel toward the palm. No tiled or cell-based noise.
    float pulse = pow(0.5 + 0.5 * sin(station * 0.035 + time * 5.8 + seed), 3.0);
    float curl = sin(station * 0.046 + time * 3.4 + seed + sin(d * 0.29 - time * 1.7) * 1.1);
    float width = (5.3 + pulse * 2.4 + curl * 0.9) * power * (0.7 + t * 0.32);
    float distance = abs(d + sin(station * 0.028 + time * 2.2 + seed) * envelope * 1.7);
    float density = (1.0 - smoothstep(width * 0.36, width * 1.4, distance)) * within;
    float coreAlpha = density * (0.46 + 0.14 * pulse + 0.06 * curl);
    float marbling = 0.5 + 0.5 * sin(d * 0.53 + station * 0.025 + time * 2.7 + curl * 1.5);
    vec3 pigment = mix(vec3(0.24, 0.025, 0.46), vec3(0.49, 0.11, 0.73), marbling * 0.65 + pulse * 0.22);
    vec3 radiance = pigment * coreAlpha;
    // Soft violet volume, not a white spine or three equally bright wires.
    radiance += vec3(0.16, 0.016, 0.4) * soft(d, width * 1.75) * (0.035 + pulse * 0.05) * within;
    float vein = soft(d - sin(station * 0.031 + time * 2.9 + seed) * width * 0.5, width * 0.26);
    radiance += vec3(0.5, 0.14, 0.75) * vein * density * (0.18 + pulse * 0.5);
    float rolling = pow(0.5 + 0.5 * sin(station * 0.052 + time * 7.0 + sin(d * 0.4 + curl) * 1.4), 3.0);
    radiance += vec3(0.38, 0.09, 0.64) * rolling * density * 0.24;
    for (int i = 0; i < 2; i++) {
      float k = float(i), phase = station * (0.024 + k * 0.004) + time * (2.8 + k * 0.3) + seed + k * 2.7;
      float side = sin(phase) * envelope * (8.0 + k * 3.2) * power;
      float packets = smoothstep(0.25, 0.95, 0.5 + 0.5 * sin(station * 0.043 + time * 6.0 + k * 2.0));
      float wisp = soft(p.y - centre - side, (1.25 + 0.3 * sin(phase)) * power);
      radiance += vec3(0.18, 0.025, 0.42) * wisp * packets * 0.34 * within;
    }
    // Target extraction bloom and palm convergence, with no opaque outer disk.
    for (int i = 0; i < 2; i++) {
      vec2 q = p - vec2((float(i) - 0.5) * lengthX, 0.0);
      float a = atan(q.y, q.x), r = length(q);
      float swirl = sin(a * 3.0 + r * 0.18 - time * 3.4 + seed);
      float cloud = soft(r, (11.0 + swirl * 1.5) * power);
      float capture = cloud * 0.34;
      vec3 violet = vec3(0.35, 0.055, 0.62);
      radiance = radiance * (1.0 - capture) + violet * capture;
      coreAlpha = coreAlpha + capture * (1.0 - coreAlpha);
      float wisps = soft(r - (12.0 + swirl * 3.2) * power, 2.4 * power) * (0.5 + 0.5 * swirl);
      radiance += vec3(0.24, 0.03, 0.54) * wisps * 0.4 + vec3(0.4, 0.14, 0.65) * soft(r, 3.0 * power) * 0.25;
    }
    // Premultiplied pigment + emitted light. Alpha exists only on the shaped purple plasma.
    return vec4(radiance, sat(coreAlpha));
  }
  vec4 piercingFlood(vec2 p, float age, float gain, float lengthX, float halfWidth) {
    float station = p.x + lengthX * 0.5;
    vec2 source = vec2(station, p.y);
    float windup = clamp(age / 0.6, 0.0, 1.0), r = length(source);
    vec3 energy = vec3(0.0);
    if (age < 0.6) {
      float spin = atan(source.y, source.x) + age * 6.0;
      float ring = soft(r - (24.0 - windup * 10.0), 1.7) * (0.3 + 0.7 * pow(max(0.0, cos(spin * 3.0)), 3.0));
      energy = vec3(0.65, 0.12, 0.92) * ring * windup + vec3(0.88, 0.55, 1.0) * soft(r, 4.0 + windup * 8.0) * windup;
    } else {
      float time = age - 0.6;
      float on = smoothstep(0.0, 0.055, time) * gain;
      float within = smoothstep(-3.0, 10.0, station) * (1.0 - smoothstep(lengthX - 8.0, lengthX + 3.0, station));
      float u = clamp(station / max(1.0, lengthX), 0.0, 1.0);
      float roll = sin(station * 0.035 - time * 12.0 + sin(p.y * 0.12 + time * 3.0));
      float width = halfWidth * (0.9 + roll * 0.055) * (0.84 + u * 0.16);
      float body = 1.0 - smoothstep(width * 0.42, width, abs(p.y));
      float core = soft(p.y, halfWidth * 0.13) * (0.68 + 0.12 * sin(station * 0.07 - time * 17.0));
      float ribs = soft(p.y - sin(station * 0.045 - time * 9.0) * width * 0.45, halfWidth * 0.1);
      float glow = soft(p.y, halfWidth * 1.28) * 0.08;
      energy = (vec3(0.3, 0.035, 0.63) * body * (0.7 + roll * 0.12) +
        vec3(0.92, 0.84, 0.98) * core + vec3(0.72, 0.24, 0.8) * ribs * body * 0.44 +
        vec3(0.49, 0.055, 0.84) * glow) * within * on;
      for (int i = 0; i < 2; i++) {
        float k = float(i), wave = sin(station * 0.027 - time * (6.3 + k) + k * 3.141593);
        float strand = soft(p.y - wave * halfWidth * 1.13, halfWidth * 0.065);
        energy += vec3(0.58, 0.1, 0.77) * strand * (0.28 + 0.3 * sin(u * 3.141593)) * within * on;
      }
      energy += vec3(0.68, 0.21, 0.88) * soft(r, halfWidth * 1.05) * on * 0.3;
      energy += vec3(0.97, 0.74, 0.88) * soft(r, halfWidth * 0.3) * on * 0.65;
    }
    return vec4(energy, max(energy.r, max(energy.g, energy.b)));
  }
  vec4 frag () {
    vec2 p = vec2(uv0.x - 0.5, 0.5 - uv0.y) * fxShape.xy;
    vec4 result;
    if (fxState.w < 0.5) {
      p.y += fxShape.w;
      result = explosion(p, fxState.x, fxState.y, fxShape.z, fxState.z);
    } else if (fxState.w < 1.5) {
      result = ground(p, fxState.x, fxState.y, fxShape.z, fxShape.w);
    } else if (fxState.w < 2.5) {
      result = siphon(p, fxState.x, fxState.y, fxState.z, fxShape.z);
    } else {
      result = piercingFlood(p, fxState.x, fxState.z, fxShape.z, fxShape.w);
    }
    // Prevent faint quad borders from noise or glow, including the longest beam diagonals.
    vec2 margin = min(uv0, vec2(1.0) - uv0) * fxShape.xy;
    vec2 edge = smoothstep(vec2(0.0), vec2(8.0), margin);
    float opacity = edge.x * edge.y * color.a;
    // Plasma already contains premultiplied pigment and light; never multiply it by alpha again.
    if (fxState.w >= 1.5) return vec4(result.rgb * opacity * color.rgb, result.a * opacity);
    return vec4(result.rgb * color.rgb, result.a * opacity);
  }
}%
