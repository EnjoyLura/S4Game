CCEffect %{
  techniques:
  - passes:
    - vert: ice-vs:vert
      frag: ice-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        iceState: { value: [0, 1.5, 0, 0] }
}%

CCProgram ice-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    color = a_color;
    uv0 = a_texCoord;
    return cc_matViewProj * p;
  }
}%

CCProgram ice-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec4 color;
  in vec2 uv0;
  uniform Ice {
    vec4 iceState;
  };
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  float grain(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    vec4 a = fract(sin(vec4(dot(i, vec2(127.1, 311.7)), dot(i + vec2(1.0, 0.0), vec2(127.1, 311.7)),
      dot(i + vec2(0.0, 1.0), vec2(127.1, 311.7)), dot(i + vec2(1.0), vec2(127.1, 311.7)))) * 43758.5453);
    return mix(mix(a.x, a.y, f.x), mix(a.z, a.w, f.x), f.y);
  }
  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    float age = iceState.x, seed = iceState.z;
    float thaw = clamp((age - iceState.y) / 0.55, 0.0, 1.0);
    float scan = uv0.x + uv0.y * 0.32 - fract(age * 0.72 + seed);
    float glint = exp(-scan * scan / 0.0007) * 0.22 * (1.0 - thaw);
    float flash = (1.0 - smoothstep(0.04, 0.22, age)) * 0.20;
    o.rgb = mix(o.rgb, vec3(0.87, 0.98, 1.0), glint + flash) * color.rgb;
    // Frozen facets break up softly before the separately animated chips finish dispersing.
    float dissolve = 1.0 - smoothstep(grain(uv0 * 29.0 + seed) * 0.45, 0.98, thaw);
    o.a *= color.a * dissolve;
    return o;
  }
}%
