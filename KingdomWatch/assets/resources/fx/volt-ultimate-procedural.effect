CCEffect %{
  techniques:
  - passes:
    - vert: thunder-vs:vert
      frag: thunder-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        strikeState: { value: [0, 1, 0, 600] }
        strikeShape: { value: [196, 600, 90, 1] }
}%

CCProgram thunder-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * p;
  }
}%

CCProgram thunder-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  uniform Thunder {
    vec4 strikeState;
    vec4 strikeShape;
  };
  float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    return fract(p * (p + p));
  }
  float jag(float p) {
    float i = floor(p), f = fract(p);
    // Mostly linear facets, with softened corners rather than regularly spaced teeth.
    f = mix(f, f * f * (3.0 - 2.0 * f), 0.35);
    return mix(hash11(i), hash11(i + 1.0), f) * 2.0 - 1.0;
  }
  float channel(float y, float seed) {
    float drift = (jag(y * 0.006 + seed) - jag(seed)) * 23.0;
    float facets = (jag(y * 0.035 + seed * 3.7) - jag(seed * 3.7)) * 7.5;
    float detail = (jag(y * 0.14 + seed * 1.9) - jag(seed * 1.9)) * 1.9;
    return (drift + facets + detail) * smoothstep(0.0, 18.0, y);
  }
  float gaussian(float d, float w) { return exp(-d * d / (w * w)); }
  vec3 electric(float d, float width) {
    // Continuous falloff provides real soft bloom, with no opaque outline bands.
    return vec3(0.40, 0.10, 1.0) * gaussian(d, width * 12.0) * 0.15
         + vec3(0.68, 0.18, 1.0) * gaussian(d, width * 4.3) * 0.54
         + vec3(0.80, 0.48, 1.0) * gaussian(d, width * 1.8) * 0.76
         + vec3(1.0, 0.95, 1.0) * gaussian(d, width * 0.58) * 1.10;
  }
  vec4 frag () {
    float age = strikeState.x, seed = strikeState.y;
    vec2 p = vec2((uv0.x - 0.5) * strikeShape.x, (1.0 - uv0.y) * strikeShape.y);
    vec3 rgb = vec3(0.0);
    float opacity = 1.0;
    if (strikeState.z < 0.5) {
      p.y -= 16.0;
      float life = 1.0 - smoothstep(0.16, 0.31, age);
      // One channel, then a return stroke along that SAME path, never a new giant zigzag.
      float pulse = exp(-age * 18.0) + 0.64 * gaussian(age - 0.085, 0.018);
      float power = (0.20 + pulse) * life;
      float center = channel(p.y, seed);
      float width = 1.45 + 0.75 * hash11(floor(p.y / 28.0) + seed * 9.0);
      width *= 0.85 + 0.32 * smoothstep(20.0, 300.0, p.y);
      rgb = electric(p.x - center, width) * power;
      for (int i = 0; i < 3; i++) {
        float k = float(i), branchSeed = seed + k * 7.3;
        float rootY = strikeState.w * (0.23 + k * 0.23);
        float lengthY = min(150.0, strikeState.w * 0.28) * (0.72 + hash11(branchSeed) * 0.28);
        float u = (rootY - p.y) / max(lengthY, 1.0);
        if (u > 0.0 && u < 1.0) {
          float side = mod(floor(seed) + k, 2.0) * 2.0 - 1.0;
          float reach = 24.0 + hash11(branchSeed * 2.1) * 29.0;
          float fork = channel(rootY, seed) + side * reach * u;
          fork += (jag(u * 6.0 + branchSeed) - jag(branchSeed)) * sin(u * 3.141593) * 6.0;
          float tip = (1.0 - u) * smoothstep(0.0, 0.045, u);
          rgb += electric(p.x - fork, max(0.45, 1.0 - u * 0.6)) * tip * power * 0.74;
        }
      }
      // A short, vertically stretched contact flare connects the sky channel to the foot point.
      rgb += vec3(0.66, 0.20, 1.0) * gaussian(p.x, 13.0) * gaussian(p.y - 9.0, 34.0) * pulse * 0.55;
      opacity = smoothstep(-12.0, 0.0, p.y) * life;
      opacity *= 1.0 - smoothstep(strikeShape.x * 0.39, strikeShape.x * 0.5, abs(p.x));
    } else {
      // Ground is centered on its carrier, just like the CPU cracks and sky foot.
      // The sky's p.x was already centered; subtracting half-width again clipped half the ring.
      p = vec2(uv0.x - 0.5, 0.5 - uv0.y) * strikeShape.xy;
      // Project all ground light onto one flattened battlefield plane.
      vec2 q = p / vec2(1.0, 0.43);
      float r = length(q), angle = atan(q.y, q.x), radius = strikeShape.z;
      float fade = 1.0 - smoothstep(0.12, 0.58, age);
      float pulse = exp(-age * 23.0) + 0.24 * gaussian(age - 0.09, 0.035);
      float spread = 1.0 - exp(-age * 13.0);
      float ring = radius * (0.18 + spread * 0.92);
      float ripples = sin(angle * 5.0 + seed) * 1.8 + sin(angle * 9.0 - seed) * 0.9;
      float d = r - ring - ripples;
      float gaps = 0.22 + 0.78 * pow(0.5 + 0.5 * sin(angle * 3.0 + seed), 2.0);
      rgb = vec3(0.44, 0.08, 1.0) * gaussian(r, radius * 0.62) * (0.19 + pulse * 0.43);
      rgb += vec3(0.72, 0.18, 1.0) * gaussian(r, 21.0) * pulse * 0.78;
      rgb += vec3(1.0, 0.84, 1.0) * gaussian(r, 8.5) * pulse;
      rgb += vec3(0.48, 0.12, 1.0) * gaussian(d, 9.0) * gaps * 0.34;
      rgb += vec3(0.88, 0.40, 1.0) * gaussian(d, 2.2) * gaps * 0.45;
      rgb += vec3(1.0, 0.90, 1.0) * gaussian(d, 0.75) * gaps * 0.28;
      opacity = fade * (1.0 - smoothstep(radius * 1.15, radius * 1.48, r));
    }
    return vec4(rgb * color.rgb, opacity * strikeShape.w * color.a);
  }
}%
