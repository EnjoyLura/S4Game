CCEffect %{
  techniques:
  - passes:
    - vert: wind-volume-vs:vert
      frag: wind-volume-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        volumeState: { value: [0, 0, 0, 0.73] }
        volumeShape: { value: [270, 270, 100, 4] }
        volumeMap: { value: black }
}%

CCProgram wind-volume-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * p;
  }
}%

CCProgram wind-volume-fs %{
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  // Exact host/art-preview ABI. Age uses the paused battle clock, never cc_time.
  // State: age, opacity, kind (0 eye / 1 tornado), stable seed (.73).
  // Shape: quad width, quad height, field radius, host duration.
  uniform Volume {
    vec4 volumeState;
    vec4 volumeShape;
  };
  uniform sampler2D volumeMap;
  const float TAU = 6.28318530718;

  float windHash(vec2 p) {
    vec3 q = fract(vec3(p.x, p.y, p.x) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
  }
  float windGrain(vec2 p) {
    vec2 cell = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(windHash(cell), windHash(cell + vec2(1.0, 0.0)), f.x),
      mix(windHash(cell + vec2(0.0, 1.0)), windHash(cell + vec2(1.0)), f.x), f.y);
  }

  vec2 eyeFlow(vec2 uv, float age, float seed) {
    // Work in an elliptical polar domain. Tangential interior flow keeps the
    // painted oval anchored; its outer silhouette has zero UV displacement.
    vec2 axis = vec2(0.44, 0.36), p = (uv - vec2(0.5)) / axis;
    float r = length(p);
    float interior = 1.0 - smoothstep(0.55, 1.06, r);
    float fold = sin(r * 12.0 - age * 4.1 + seed);
    vec2 tangent = vec2(-p.y, p.x) * axis;
    return (tangent * (0.26 + fold * 0.035) + p * axis * fold * 0.012) * interior;
  }

  vec2 tornadoFlow(vec2 uv, float age, float seed) {
    // Cylindrical height-dependent shear and rising internal folds, not a
    // rotating/scrolling rectangular sticker. The crown, base and sides stay put.
    float h = 1.0 - uv.y;
    float width = mix(0.09, 0.43, smoothstep(0.08, 0.92, h));
    float x = (uv.x - 0.5) / width;
    float depth = sqrt(max(0.0, 1.0 - min(x * x, 1.0)));
    float interior = (1.0 - smoothstep(0.55, 1.0, abs(x)))
      * smoothstep(0.08, 0.22, h) * (1.0 - smoothstep(0.78, 0.94, h));
    float roll = h * 18.0 - age * 5.8 + seed + depth * 2.2;
    return vec2((0.038 + h * 0.020) * sin(roll),
      -0.018 * depth * (0.70 + 0.30 * cos(roll + x * 2.0))) * interior;
  }

  vec4 paintedFrame(float index, vec2 uv) {
    // Cocos sprite UV y=0 is TOP: TL, TR, BL, BR. No vertical flip here.
    vec2 cell = vec2(mod(index, 2.0), floor(index * 0.5));
    // At least two SOURCE pixels inside each 512px cell. Bilinear taps retain
    // a >1px margin even at a corner, and never reach an adjacent frame.
    vec2 localUV = clamp(uv, vec2(2.0 / 512.0), vec2(1.0 - 2.0 / 512.0));
    vec4 sampleColor = texture(volumeMap, (cell + localUV) * 0.5);
    // Straight RGBA art: premultiply EACH sample before temporal interpolation.
    // Transparent black cannot darken the other frame's fibers during blending.
    return vec4(sampleColor.rgb * sampleColor.a, sampleColor.a);
  }

  vec4 frag () {
    vec2 margin = min(uv0, vec2(1.0) - uv0) * max(volumeShape.xy, vec2(1.0));
    vec2 edge = smoothstep(vec2(0.0), vec2(3.0), margin);
    float strength = clamp(volumeState.y, 0.0, 1.0) * edge.x * edge.y;
    if (strength <= 0.0) return vec4(0.0);

    float age = max(volumeState.x, 0.0), seed = volumeState.w * TAU;
    float kind = step(0.5, volumeState.z);
    float cycles = mix(0.98, 1.04, kind);
    float phase = fract(age * cycles) * 4.0;
    float current = floor(phase), next = mod(current + 1.0, 4.0), t = fract(phase);
    vec2 flow;
    if (kind < 0.5) flow = eyeFlow(uv0, age, seed);
    else flow = tornadoFlow(uv0, age, seed);
    // Advect both neighboring frames toward the same intermediate instant.
    // Signed offsets meet continuously at every frame boundary, including 3->0;
    // no sawtooth UV reset, full-atlas scrolling, or whole-texture rotation.
    float frameSeconds = 0.25 / cycles;
    vec4 a = paintedFrame(current, uv0 - flow * t * frameSeconds);
    vec4 b = paintedFrame(next, uv0 + flow * (1.0 - t) * frameSeconds);
    vec4 painted = mix(a, b, t);
    if (painted.a <= 0.0) return vec4(0.0);

    // Broad painted white/jade/teal volumes remain the source of color AND
    // coverage. Small moving fiber modulation adds detail only inside real art.
    float grain = windGrain(uv0 * vec2(13.0, 19.0) + vec2(seed, -age * 0.65));
    float fiber = sin(uv0.x * 41.0 + uv0.y * 57.0 - age * 7.0 + grain * 2.0);
    float brightness = 1.0 + fiber * 0.025 + (grain - 0.5) * 0.025;
    // Cap actual volume coverage at .65, retaining softer source alpha below
    // that cap. Rescale RGB with alpha so highlights never become additive wire.
    float coverage = min(painted.a, 0.65);
    vec3 pigment = min(painted.rgb * brightness, vec3(painted.a));
    vec3 rgb = pigment * (coverage / max(painted.a, 0.000001));
    // Host opacity already contains entry/end fades. Do not double-apply color.a
    // or invent a second duration fade; duration remains part of the shared ABI.
    return vec4(rgb * clamp(color.rgb, vec3(0.0), vec3(1.0)) * strength, coverage * strength);
  }
}%
