     : CARD_ART[card.id] || 'ui_card_' + card.id);
+}
+
+/** Fire cards have one filled circular viewport, including legacy/shared art. Clip only the icon subtree. */
+export function pickCardIcon(parent: Node, x: number, y: number, size: number, card: CardDef, hideOnLoad: Node[] = []): Node {
+  if (card.owner !== 'pyro') return artSprite(parent, x, y, size, size, pickCardArt(card), { sliced: false, hideOnLoad });
