+      { name: 'stageGuaranteedReward:' + row.id, radius: 12, fill: row.id === 'coin' ? '#F8DFA8' : COMIC.card });
+    if (row.id === 'coin') comicArt(card, -w / 2 + 29, 0, 44, 44, 'comic_coin_v1');
