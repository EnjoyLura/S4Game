+/** Keep the existing description box and every condition/tradeoff; at most four semantic lines. */
+export function cardChoiceDescription(card: CardDef, stacks: Readonly<CardStacks>, team: BuildTeam): string {
+  const lines = card.desc.split('\n').filter(line => !/^最多\s*\d+\s*层$/.test(line) && line !== '可叠加');
+  const hint = cardComboHint(card, stacks, team);
+  if (hint && lines.length < 3) lines.push(hint);
+  const current = stacks[card.id] || 0;
+  lines.push('叠层 ' + current + '→' + Math.min(card.maxStacks, current + 1) + ' / ' + card.maxStacks);
+  return lines.join('\n');
+}
