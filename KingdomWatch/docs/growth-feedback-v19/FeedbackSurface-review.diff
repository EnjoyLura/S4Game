+/** Dense center keeps numbers readable; only the empty ends feather into the scene. */
+export function growthSurface(parent: Node, width: number, height: number): Node {
+  const node = N('growthResultSurface', parent);
+  feedbackSurface(node, 'readableCenter', 'growth', 0, 0, width, height, '#101F2B', .985);
+  for (const side of [-1, 1]) {
+    feedbackSurface(node, 'outerRule', 'line', 0, side * (height / 2 - 1), width, 2.4, '#F1CE81', .9);
+    feedbackSurface(node, 'innerRule', 'line', 0, side * (height / 2 - 5), width, 1, '#F1CE81', .38);
+  }
+  return node;
+}
